$global_determinator shadertype 0 14
$global_determinator alphatest 0 2
$global_determinator blended 0 1
$invalid_state 2 alphatest 1 2 shadertype 6 8
$shader_vertex $begin
#version 460

uniform mat4 projection;
uniform mat4 modelview;

// Cubemaps
uniform mat4 modelmatrix;
uniform highp mat4 inv_modelmatrix;

// lighting
uniform mat4 light_0_matrix;
uniform mat4 light_1_matrix;
uniform mat4 light_2_matrix;
uniform mat4 light_3_matrix;
uniform mat4 csm_matrix;

uniform mat4 normalmatrix;

// chrome
uniform vec3 v_origin;
uniform vec3 v_right;

// Scrolling
uniform vec2 uvoffset;

// Decals
uniform float decalscale;

// Caustics
uniform vec4 caustics_m1;
uniform vec4 caustics_m2;

// Determinators turned into uniforms
uniform highp int d_fogtype;
uniform highp int d_bumpmapping;
uniform highp int d_mrao;
uniform highp int d_cubemaps;
uniform highp int d_numlights;
uniform highp int d_light0_shadowmap;
uniform highp int d_light1_shadowmap;
uniform highp int d_light2_shadowmap;
uniform highp int d_light3_shadowmap;
uniform highp int d_csm;

in vec4 in_position;
in vec3 in_normal;
in vec3 in_binormal;
in vec3 in_tangent;
in vec2 in_lmapcoord[4];
in vec4 in_styles;
in vec2 in_texcoord;
in vec2 in_dtexcoord;
in float in_fogcoord;
in float in_alpha;

out vec2 ps_lmapcoord[4];
flat out vec4 ps_styles;
out vec2 ps_texcoord;
out vec2 ps_dtexcoord;
out vec2 ps_chromecoord;
out vec2 ps_causticcoord;

out vec3 ps_tangent;
out vec3 ps_binormal;
out vec3 ps_normal;

out vec4 ps_light_0_vertexcoord; // projection space
out vec4 ps_light_1_vertexcoord; // projection space
out vec4 ps_light_2_vertexcoord; // projection space
out vec4 ps_light_3_vertexcoord; // projection space
out vec4 ps_csm_vertexcoord;

out float ps_fogcoord; // static fogcoord
out float ps_alpha;
out vec3 ps_vertexpos;

out vec3 ps_cubenormal;
out vec3 ps_cubetangent;
out vec3 ps_cubebinormal;
out vec3 ps_cubevertexpos;

void main()
{
	vec4 position = in_position*modelview;
	ps_vertexpos = position.xyz;
	ps_alpha = in_alpha;
	
	if(d_fogtype == 2)
		ps_fogcoord = in_fogcoord;
	
	$branch shadertype == 0 || shadertype == 1 || shadertype == 2 || shadertype == 3 || shadertype == 5 || shadertype == 12
	$begin
		for (int i = 0; i < 4; i++)
		{
			ps_lmapcoord[i] = in_lmapcoord[i];
		}
		ps_styles = in_styles;
	$end
	
	$branch shadertype == 0 || shadertype == 1 || shadertype == 2 || shadertype == 4 || shadertype == 5 || shadertype == 8 || shadertype == 9
	$begin
		ps_texcoord = in_texcoord+uvoffset;
	$end
	
	$branch shadertype == 10 || shadertype == 11
	$begin
		vec2 centered_texcoord = in_texcoord - vec2(0.5, 0.5);
		ps_texcoord = (centered_texcoord * decalscale) + vec2(0.5, 0.5);
	$end	
	
	if(d_mrao == 1)
	{
		ps_tangent = (normalmatrix*vec4(in_tangent, 0.0)).xyz;
		ps_binormal = (normalmatrix*vec4(in_binormal, 0.0)).xyz;
		ps_normal = (normalmatrix*vec4(in_normal, 0.0)).xyz;
	}
	
	if (d_cubemaps >= 1)
	{
		if (d_bumpmapping == 1)
		{
			ps_cubetangent = (inv_modelmatrix*vec4(in_tangent, 0.0)).xyz;
			ps_cubebinormal = (inv_modelmatrix*vec4(in_binormal, 0.0)).xyz;
		}
		
		ps_cubenormal = (inv_modelmatrix*vec4(in_normal, 0.0)).xyz;
		ps_cubevertexpos = (in_position * modelmatrix).xyz;
	}
	
	$branch shadertype == 0 || shadertype == 9 || shadertype == 10 || shadertype == 11
	$begin
		ps_dtexcoord = in_dtexcoord;
	$end

	$branch shadertype == 2
	$begin
		vec3 chromeup, chromeright, tmp;
		tmp = v_origin * -1;
		tmp += in_position.xyz;

		tmp = normalize(tmp);
		chromeup = cross(tmp, v_right);
		chromeup = normalize(chromeup);

		chromeright = cross(tmp, chromeup);
		chromeright = normalize(chromeright);

		float n = dot(in_normal, chromeright);
		ps_chromecoord.x = (n*0.5) + 0.5;

		n = dot(in_normal, chromeup);
		ps_chromecoord.y = (n*0.5) + 0.5;
	$end
	
	if (d_numlights >= 1)
		ps_light_0_vertexcoord = light_0_matrix * in_position;
	if (d_numlights >= 2)
		ps_light_1_vertexcoord = light_1_matrix * in_position;
	if (d_numlights >= 3)
		ps_light_2_vertexcoord = light_2_matrix * in_position;
	if (d_numlights >= 4)
		ps_light_3_vertexcoord = light_3_matrix * in_position;
	if (d_csm == 1)
		ps_csm_vertexcoord = csm_matrix * vec4(in_position.xyz + in_normal * 1.5, 1.0);
	
	ps_causticcoord.x = dot(in_position, caustics_m1);
	ps_causticcoord.y = dot(in_position, caustics_m2);

	gl_Position = position*projection;
}
$end
$shader_fragment $begin
#version 460
#define M_PI 3.14159265358979323846264338327950288

uniform samplerCube cubemap;
uniform samplerCube cubemap_prev;
uniform float u_lightstyle_values[256];
uniform sampler2D baselightmap[4];
uniform sampler2D difflightmap[4];
uniform sampler2D lightvecstex[4];
uniform sampler2D maintexture;
uniform sampler2D detailtex;
uniform sampler2D chrometex;
uniform sampler2D normalmap;
uniform sampler2D mraotex;

uniform sampler2D causticstex1;
uniform sampler2D causticstex2;
uniform vec4 causticscolor;

$branch blended == 1
$begin
uniform sampler2D maintexture2;
uniform sampler2D normalmap2;
uniform sampler2D mraotex2;
$end

uniform vec3 light_0_origin;
uniform float light_0_radius;
uniform vec4 light_0_color;
uniform sampler2D light_0_projtexture;
uniform float light_0_cone_size;
uniform vec3 light_0_spotdirection;
uniform samplerCube light_0_cubemap;
uniform sampler2D light_0_shadowmap;

uniform vec3 light_1_origin;
uniform float light_1_radius;
uniform vec4 light_1_color;
uniform sampler2D light_1_projtexture;
uniform float light_1_cone_size;
uniform vec3 light_1_spotdirection;
uniform samplerCube light_1_cubemap;
uniform sampler2D light_1_shadowmap;

uniform vec3 light_2_origin;
uniform float light_2_radius;
uniform vec4 light_2_color;
uniform sampler2D light_2_projtexture;
uniform float light_2_cone_size;
uniform vec3 light_2_spotdirection;
uniform samplerCube light_2_cubemap;
uniform sampler2D light_2_shadowmap;

uniform vec3 light_3_origin;
uniform float light_3_radius;
uniform vec4 light_3_color;
uniform sampler2D light_3_projtexture;
uniform float light_3_cone_size;
uniform vec3 light_3_spotdirection;
uniform samplerCube light_3_cubemap;
uniform sampler2D light_3_shadowmap;

uniform sampler2DShadow csm_shadowmap;
uniform vec4 csm_light_color;
uniform vec3 csm_direction;

uniform float interpolant;
uniform float cubemapstrength;

// Parallax correction
uniform vec3 u_cube_min;
uniform vec3 u_cube_max;
uniform vec3 u_cube_origin;
uniform vec3 u_cube_prev_min;
uniform vec3 u_cube_prev_max;
uniform vec3 u_cube_prev_origin;
uniform highp mat4 inv_modelmatrix;

uniform float u_heightscale;

uniform float decalalpha;
uniform float light_radius;

uniform vec3 fogcolor;
uniform vec2 fogparams;// end, 1/(end-start)

uniform vec4 color;

// Determinators turned into uniforms
uniform highp int d_fogtype;
uniform highp int d_bumpmapping;
uniform highp int d_mrao;
uniform highp int d_cubemaps;
uniform highp int d_numlights;
uniform highp int d_light0_shadowmap;
uniform highp int d_light1_shadowmap;
uniform highp int d_light2_shadowmap;
uniform highp int d_light3_shadowmap;
uniform highp int d_csm;
uniform highp int d_lightmap_bicubic;

in vec2 ps_lmapcoord[4];
flat in vec4 ps_styles;
in vec2 ps_texcoord;
in vec2 ps_dtexcoord;
in vec2 ps_chromecoord;
in vec2 ps_causticcoord;
in vec3 ps_normal;
in vec3 ps_tangent;
in vec3 ps_binormal;

in vec4 ps_light_0_vertexcoord; // projection space
in vec4 ps_light_1_vertexcoord; // projection space
in vec4 ps_light_2_vertexcoord; // projection space
in vec4 ps_light_3_vertexcoord; // projection space
in vec4 ps_csm_vertexcoord;

in float ps_fogcoord; // static fogcoord
in float ps_alpha;
in vec3 ps_vertexpos; // for radial fog

in vec3 ps_cubenormal;
in vec3 ps_cubetangent;
in vec3 ps_cubebinormal;
in vec3 ps_cubevertexpos;

out vec4 oColor;

// Blend functions
vec4 GetMainTexture(vec2 uv)
{
	vec4 col1 = texture(maintexture, uv);
	$branch blended == 1
	$begin
		vec4 col2 = texture(maintexture2, uv);
		return mix(col1, col2, ps_alpha);
	$end
	$branch blended == 0
	$begin
		return col1;
	$end
}

vec3 GetNormalMapSample(vec2 uv)
{
	vec3 norm1 = texture(normalmap, uv).xyz;
	$branch blended == 1
	$begin
		vec3 norm2 = texture(normalmap2, uv).xyz;
		return mix(norm1, norm2, ps_alpha);
	$end
	$branch blended == 0
	$begin
		return norm1;
	$end
}

vec4 GetMRAOSample(vec2 uv)
{
	vec4 mrao1 = texture(mraotex, uv);
	$branch blended == 1
	$begin
		vec4 mrao2 = texture(mraotex2, uv);
		return mix(mrao1, mrao2, ps_alpha);
	$end
	$branch blended == 0
	$begin
		return mrao1;
	$end
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
	float a = roughness*roughness;
	float a2 = a*a;
	float NdotH = max(dot(N, H), 0.0);
	float NdotH2 = NdotH*NdotH;

	float nom = a2;
	float denom = (NdotH2*(a2-1.0)+1.0);
	denom = M_PI*denom*denom;

	return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
	float r = roughness+1.0;
	float k = (r*r)/8.0;

	float nom = NdotV;
	float denom = NdotV*(1.0-k)+k;

	return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float ggx1 = GeometrySchlickGGX(NdotV, roughness);
	float ggx2 = GeometrySchlickGGX(NdotL, roughness);

	return ggx1*ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
	return F0+(1.0-F0)*pow(clamp(1.0-cosTheta, 0.0, 1.0), 5.0);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
	return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 CookTorranceSpecular( vec3 v_origin, vec3 v_normal, vec3 lightDir, float roughness, vec3 F0 )
{
	// Eye vector (surface to camera)
	vec3 eyeVec = normalize( -v_origin );
	
	// Light vector (surface to light source)
	vec3 lightVec = normalize( -lightDir );
	
	// Halfway vector
	vec3 halfVec = normalize( lightVec + eyeVec );
	
	float NDF = DistributionGGX(v_normal, halfVec, roughness);
	float G = GeometrySmith(v_normal, eyeVec, lightVec, roughness);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	
	float NdotV = max(dot(v_normal, eyeVec), 0.0);
	float NdotL = max(dot(v_normal, lightVec), 0.0);
	
	float denom = 4.0 * NdotV * NdotL + 0.0001;
	
	return (NDF * G * F) / denom;
}

vec4 EncodeDepth( vec3 v_origin, float l_radius )
{
	float depth = length(v_origin);
	depth = clamp((depth/l_radius), 0.0, 1.0);

	vec2 momments = vec2(depth, depth*depth);
	float dx = dFdx(depth);
	float dy = dFdy(depth);
	momments.y += 0.25*(dx*dx+dy*dy);

	vec2 fracval = fract(momments*32);

	vec4 finalColor;
	finalColor.x = momments.x-(fracval.x/32);
	finalColor.y = momments.y-(fracval.y/32);
	finalColor.zw = fracval;
	
	return finalColor;
}

float LinearStep(float in1, float in2, float pmax)  
{  
	float value = (pmax-in1)/(in2-in1);
	return clamp(value, 0.0, 1.0);
}

float ReduceLightBleeding(float p_max, float Amount)  
{    
	return LinearStep(Amount, 1, p_max);  
}

float DepthTestCube( float depthcoord, samplerCube shadowmap, vec3 coord )
{
	vec4 momments = texture(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32;
	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0);
	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

float DepthTestProj( float depthcoord, sampler2D shadowmap, vec4 coord )
{
	vec4 momments = textureProj(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32;
	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0);
	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

vec4 AddPointLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec3 v_normal, vec3 mrao, vec3 albedo, out vec3 specOut )
{
	float rad = l_radius * l_radius;
	vec3 dir = l_origin - v_origin;
	
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	
	dir = normalize(dir);
	attn = clamp(attn, 0.0, 1.0);
	
	float dp = dot(dir, v_normal);
	attn = max(dp, 0.0)*attn;
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * attn * l_color;
	
	specOut = vec3(0.0);
	if (d_mrao == 1)
	{
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * l_color;
	}
	
	outColor.w = 0.0;
	return outColor;
}

float GetPointLightShadowing( float l_radius, vec4 v_coord, samplerCube l_shadowmap )
{
	float fldistance = clamp((length(v_coord.xyz)/l_radius), 0.0, 1.0);
	float flresult = DepthTestCube(fldistance, l_shadowmap, normalize(v_coord.xyz));
	return ReduceLightBleeding(flresult, 0.4);
}

vec4 AddProjLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec4 v_coord, vec3 v_normal, sampler2D l_texture, vec3 mrao, vec3 albedo, float l_cone_size, vec3 l_spotdirection, out vec3 specOut )
{
	float rad = l_radius*l_radius;
	vec3 dir = l_origin-v_origin;
	
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	attn = clamp(attn, 0.0, 1.0);
	
	dir = normalize(dir);
	float dp = max(dot(dir, v_normal), 0.0);
	
	vec4 texclamp = max(v_coord, 0.0);
	vec4 texColor = textureProj(l_texture, texclamp);
	
	float spotcos = cos((l_cone_size*2.0)*0.3*(M_PI*2.0/360.0));
	
	vec3 spotdirection = normalize(l_spotdirection);
	float spotatten = -dot(spotdirection, dir);
	
	spotatten = max(spotatten, spotcos);
	float spotfactor = (spotatten - spotcos)/(1.0 - spotcos);
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * texColor.xyz * attn * l_color * dp * spotfactor;
	
	specOut = vec3(0.0);
	if(d_mrao == 1)
	{
		float lightStrength = (texColor.x + texColor.y + texColor.z) / 3.0;
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * dp * lightStrength * spotfactor * l_color;
	}
	
	outColor.w = 0.0;
	return outColor;
}

float GetProjLightShadowing( float l_radius, vec3 l_origin, vec3 v_origin, vec4 v_coord, vec3 v_normal, sampler2D l_shadowmap )
{
	vec4 texclamp = max(v_coord, 0.0);
	float fldistance = clamp((length(l_origin-v_origin)/l_radius), 0.0, 1.0);
	float flresult = DepthTestProj(fldistance, l_shadowmap, texclamp);
	return ReduceLightBleeding(flresult, 0.4);
}

float GetCSMShadowPCF( float currentDepth, vec2 csmUV, vec3 v_normal, sampler2DShadow l_shadowmap )
{
	return texture(l_shadowmap, vec3(csmUV, currentDepth - 0.00002));
}

vec3 AddDiffuseLight ( vec3 colorIn1, vec3 colorIn2 )
{
	vec3 outValue = colorIn1;
	outValue += colorIn2;
	return outValue;
}

vec3 AddDiffuseDynamicLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

vec3 AddSpecularLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

// Bicubic lightmapping code based on godot engine implementation
float w0(float a) 
{
	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
}

float w1(float a) 
{
	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
}

float w2(float a) 
{
	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
}

float w3(float a) 
{
	return (1.0 / 6.0) * (a * a * a);
}

float g0(float a) 
{
	return w0(a) + w1(a);
}

float g1(float a) 
{
	return w2(a) + w3(a);
}

float h0(float a) 
{
	return -1.0 + w1(a) / (w0(a) + w1(a));
}

float h1(float a) 
{
	return 1.0 + w3(a) / (w2(a) + w3(a));
}

vec4 texture_bicubic(sampler2D tex, vec2 uv, vec2 texture_size) 
{
	vec2 texel_size = vec2(1.0) / texture_size;

	uv = uv * texture_size + vec2(0.5);

	vec2 iuv = floor(uv);
	vec2 fuv = fract(uv);

	float g0x = g0(fuv.x);
	float g1x = g1(fuv.x);
	float h0x = h0(fuv.x);
	float h1x = h1(fuv.x);
	float h0y = h0(fuv.y);
	float h1y = h1(fuv.y);

	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;

	return (g0(fuv.y) * (g0x * texture(tex, p0) + g1x * texture(tex, p1))) +
			(g1(fuv.y) * (g0x * texture(tex, p2) + g1x * texture(tex, p3)));
}

vec4 SampleLightmap(sampler2D tex, vec2 uv) 
{
	if (d_lightmap_bicubic == 1) 
	{
		return texture_bicubic(tex, uv, vec2(textureSize(tex, 0)));
	} 
	else 
	{
		return texture(tex, uv);
	}
}

vec3 GetLightDir( sampler2D vecsLightmap )
{
	vec3 lightVec;
	if(d_bumpmapping == 1)
	{
		lightVec = (2.0 * SampleLightmap(vecsLightmap, ps_lmapcoord[0]).xyz) - 1.0;
		return normalize(lightVec);
	}
	else
	{
		return vec3(0, 0, 0);
	}
}

vec4 GetDiffuseLight( sampler2D diffuseTexture )
{
	if(d_bumpmapping == 1)
	{
		return SampleLightmap(diffuseTexture, ps_lmapcoord[0]);
	}
	else
	{
		return vec4(0, 0, 0, 0);
	}
}

vec4 AddBaseLight( sampler2D ambLightmap, vec4 diffuseColor, vec3 lightDir, vec3 v_normal )
{
	if(d_bumpmapping == 0)
	{
		vec4 lightmapColor = SampleLightmap(ambLightmap, ps_lmapcoord[0]);
		return lightmapColor;
	}
	else
	{
		// Lightmap is always on unit 0
		vec4 ambientColor = SampleLightmap(ambLightmap, ps_lmapcoord[0]);
		vec4 finalColor = ambientColor + diffuseColor * dot(lightDir, v_normal);
		return finalColor;
	}
}

float SplineFraction( float value, float scale )
{
	float valueSquared;

	value = scale * value;
	valueSquared = value * value;

	// Nice little ease-in, ease-out spline-like curve
	return 3 * valueSquared - 2 * valueSquared * value;
}

float CalcFogFactor_Radial( vec3 v_origin, float fogcoord, vec2 f_params )
{
	float fp_fogcoord = length(v_origin);
	float fp_fogfactor = (f_params.x - fp_fogcoord)*f_params.y;
	fp_fogfactor = SplineFraction(clamp(fp_fogfactor, 0.0, 1.0), 1.0);
	
	return 1.0-fp_fogfactor;
}

float CalcFogFactor_FogCoord( vec3 v_origin, float fogcoord, vec2 f_params )
{
	float fp_fogfactor = (f_params.x - fogcoord)*f_params.y;
	return 1.0-clamp(fp_fogfactor, 0.0, 1.0);
}

float CalcFogFactor( vec3 v_origin, float fogcoord, vec2 f_params )
{
	if(d_fogtype == 1)
		return CalcFogFactor_Radial( v_origin, fogcoord, f_params );
	else if(d_fogtype == 2)
		return CalcFogFactor_FogCoord( v_origin, fogcoord, f_params );
	else
		return 0;
}

vec3 GetCausticsColor( vec3 surfaceLight )
{
	if (causticscolor.w <= 0.0)
	{
		return vec3(0.0);
	}

	vec4 c1 = texture(causticstex1, ps_causticcoord);
	vec4 c2 = texture(causticstex2, ps_causticcoord);
	vec4 c = mix(c1, c2, interpolant);

	return c.rgb * causticscolor.rgb * surfaceLight;
}

vec3 GetTangentSpaceNormal( vec2 texcoord, vec3 v_normal )
{
	if(d_bumpmapping == 0)
	{
		return v_normal;
	}
	else
	{
		vec3 out_normal = (2.0 * GetNormalMapSample(texcoord)) - 1.0;
		return normalize(out_normal);
	}
}

vec3 GetLightDirLayer( sampler2D vecsLightmap, vec2 lmapcoord )
{
	if (d_bumpmapping == 1)
	{
		return normalize((2.0 * SampleLightmap(vecsLightmap, lmapcoord).xyz) - 1.0);
	}
	else
	{
		return vec3(0, 0, 0);
	}
}

vec4 GetDiffuseLightLayer( sampler2D diffuseTexture, vec2 lmapcoord )
{
	if (d_bumpmapping == 1)
	{
		return SampleLightmap(diffuseTexture, lmapcoord);
	}
	else
	{
		return vec4(0, 0, 0, 0);
	}
}

vec4 AddBaseLightLayer( sampler2D ambLightmap, vec4 diffuseColor, vec3 lightDir, vec3 v_normal, vec2 lmapcoord )
{
	if (d_bumpmapping == 0)
	{
		vec4 lightmapColor = SampleLightmap(ambLightmap, lmapcoord);
		return lightmapColor;
	}
	else
	{
		vec4 ambientColor = SampleLightmap(ambLightmap, lmapcoord);
		vec4 finalColor = ambientColor + diffuseColor * max(dot(lightDir, v_normal), 0.0);
		return finalColor;
	}
}

vec4 EvaluateExtraLightstyleLayers( vec3 v_normal, vec3 v_origin, vec3 mrao, vec3 albedoColor, mat3 tbnMatrix, out vec3 extraSpecular )
{
	vec4 extraColor = vec4(0.0);
	extraSpecular = vec3(0.0);

	for (int i = 1; i < 4; i++)
	{
		int styleIndex = int(ps_styles[i] + 0.5);
		if (styleIndex >= 0 && styleIndex < 254)
		{
			float styleVal = u_lightstyle_values[styleIndex];
			if (styleVal > 0.0)
			{
				vec3 dir = GetLightDirLayer(lightvecstex[i], ps_lmapcoord[i]);
				vec4 diff = GetDiffuseLightLayer(difflightmap[i], ps_lmapcoord[i]);
				extraColor += AddBaseLightLayer(baselightmap[i], diff, dir, v_normal, ps_lmapcoord[i]) * styleVal;

				if (d_mrao == 1)
				{
					vec3 eyeSpaceDir = normalize(tbnMatrix * vec3(dir[0], -dir[1], dir[2]));
					vec3 F0 = mix(vec3(0.04), albedoColor, mrao.x);
					vec3 eyeSpaceNormal = normalize(tbnMatrix * v_normal);
					vec3 spec = CookTorranceSpecular(v_origin, eyeSpaceNormal, -eyeSpaceDir, mrao.y, F0);
					extraSpecular += spec * diff.xyz * mrao.z * styleVal;
				}
			}
		}
	}

	return extraColor;
}

vec2 ParallaxMapping(sampler2D heightMapSampler, vec2 texCoords, float hScale, vec3 viewDir)
{
	float u_pomMinSteps = 4.0;
	float u_pomMaxSteps = 32.0;
	int u_pomRefineSteps = 4;

	float numLayers = mix(u_pomMaxSteps, u_pomMinSteps, abs(dot(vec3(0.0, 0.0, 1.0), viewDir)));
	float layerDepth = 1.0 / numLayers;

	vec2 p = viewDir.xy * hScale;
	vec2 deltaTexCoords = p / numLayers;

	vec2 currentTexCoords = texCoords;
	float currentLayerDepth = 0.0;
	float currentHeightMapValue = 1.0 - texture(heightMapSampler, currentTexCoords).a;

	for (int i = 0; i < int(numLayers); i++)
	{
		if (currentLayerDepth >= currentHeightMapValue)
		{
			break;
		}

		currentTexCoords -= deltaTexCoords;
		currentLayerDepth += layerDepth;
		currentHeightMapValue = 1.0 - texture(heightMapSampler, currentTexCoords).a;
	}

	vec2 texCoordsStart = currentTexCoords + deltaTexCoords;
	vec2 texCoordsEnd = currentTexCoords;
	float depthStart = currentLayerDepth - layerDepth;
	float depthEnd = currentLayerDepth;

	for (int i = 0; i < u_pomRefineSteps; i++)
	{
		float midDepth = (depthStart + depthEnd) * 0.5;
		vec2 midTexCoords = mix(texCoordsStart, texCoordsEnd, 0.5);
		float midHeightMapValue = 1.0 - texture(heightMapSampler, midTexCoords).a;

		if (midDepth > midHeightMapValue)
		{
			depthEnd = midDepth;
			texCoordsEnd = midTexCoords;
		}
		else
		{
			depthStart = midDepth;
			texCoordsStart = midTexCoords;
		}
	}

	return texCoordsEnd;
}

vec4 CombineTextureLayers( vec3 v_origin, vec3 v_normal, vec3 mrao, float mraoAlpha, vec2 uv )
{
	vec3 lightDir0 = GetLightDirLayer( lightvecstex[0], ps_lmapcoord[0] );
	vec4 lightDiffuse0 = GetDiffuseLightLayer( difflightmap[0], ps_lmapcoord[0] );
	vec4 finalColor = AddBaseLightLayer(baselightmap[0], lightDiffuse0, lightDir0, v_normal, ps_lmapcoord[0]);
	if (d_mrao == 1)
	{
		finalColor.xyz += vec3(1.0 - mraoAlpha);
	}

	vec3 albedoColor = GetMainTexture(uv).rgb;
	mat3 tbnMatrix = mat3(ps_tangent, ps_binormal, ps_normal);

	vec3 extraSpecular = vec3(0.0);
	finalColor += EvaluateExtraLightstyleLayers(v_normal, v_origin, mrao, albedoColor, tbnMatrix, extraSpecular);

	if (d_mrao == 1)
	{
		vec3 eyeSpaceNormal = normalize(tbnMatrix * v_normal);
		vec3 F0 = mix(vec3(0.04), albedoColor, mrao.x);
		vec3 eyeSpaceDir0 = normalize(tbnMatrix * vec3(lightDir0[0], -lightDir0[1], lightDir0[2]));
		vec3 spec0 = CookTorranceSpecular(v_origin, eyeSpaceNormal, -eyeSpaceDir0, mrao.y, F0);
		
		finalColor.xyz += (spec0 * lightDiffuse0.xyz * mrao.z) + extraSpecular;
	}

	$branch shadertype == 0
	$begin
		vec4 texColor = GetMainTexture(uv);
		vec4 detailTexColor = texture(detailtex, ps_dtexcoord);
		
		finalColor = finalColor*texColor*detailTexColor;
		finalColor.xyz = finalColor.xyz*4;
	$end
	$branch shadertype == 1
	$begin
		vec4 texColor = GetMainTexture(uv);
		finalColor = finalColor*texColor;
		finalColor.xyz = finalColor.xyz*2;
	$end
	$branch shadertype == 2
	$begin
		// Store light color
		vec4 lightColor = finalColor;
	
		vec4 texColor = GetMainTexture(uv);
		finalColor = lightColor*texColor;
		finalColor.xyz = finalColor.xyz*2;

		vec4 chromeTex = texture(chrometex, ps_chromecoord);
		finalColor.xyz += chromeTex.xyz*lightColor.xyz*2*color.w;
	$end
	
	finalColor.rgb += GetCausticsColor(finalColor.rgb);
	
	return finalColor;
}

vec4 GetCubemapPixel ( vec3 reflectvec, vec3 reflectvecprev, float roughness )
{
	float maxMipLevel = floor(log2(float(textureSize(cubemap, 0).x)));
	float mipLevel = clamp(roughness, 0.0, 1.0) * maxMipLevel;
	
	vec4 outColor;
	if( d_cubemaps != 2 )
	{
		outColor = textureLod(cubemap, reflectvec, mipLevel);
	}
	else
	{
		vec4 color1 = textureLod(cubemap_prev, reflectvecprev, mipLevel);
		vec4 color2 = textureLod(cubemap, reflectvec, mipLevel);
		
		outColor = (1.0 - interpolant) * color1 + color2 * interpolant;
	}
	
	return outColor;
}

vec3 CubemapParallaxCorrect(vec3 R, vec3 fragPos, vec3 boxMin, vec3 boxMax, vec3 probePos)
{
	vec3 invR = 1.0 / R;
	vec3 t1 = (boxMin - fragPos) * invR;
	vec3 t2 = (boxMax - fragPos) * invR;
	vec3 tmin = min(t1, t2);
	vec3 tmax = max(t1, t2);
	float t_near = max(max(tmin.x, tmin.y), tmin.z);
	float t_far = min(min(tmax.x, tmax.y), tmax.z);

	t_near = min(t_far, t_near);
	t_far = max(0, t_far);
	
	float intersection_t = t_far;
	vec3 intersectPos = fragPos + R * intersection_t;
	return -normalize(intersectPos - probePos);
}

vec4 AddCubemaps( vec3 mrao, vec3 albedo, vec2 uv )
{ 
	if( d_cubemaps == 0 )
	{
		return vec4(0, 0, 0, 0);
	}
	else
	{
		vec3 v_normal;
		if( d_bumpmapping == 1 )
		{
			mat3 tbnMatrix = mat3(ps_cubetangent, ps_cubebinormal, ps_cubenormal);
			vec3 tex_normal = (2.0 * GetNormalMapSample(uv)) - 1.0;
			vec3 eye_texnormal = normalize(tbnMatrix * tex_normal);
			
			v_normal = eye_texnormal;
		}
		else
		{
			v_normal = ps_cubenormal;
		}


		vec3 view_dir = normalize(ps_cubevertexpos);

		vec3 reflectvec = reflect(view_dir, v_normal);

		vec3 local_cube_min = (inv_modelmatrix * vec4(u_cube_min, 1.0)).xyz;
		vec3 local_cube_max = (inv_modelmatrix * vec4(u_cube_max, 1.0)).xyz;
		vec3 local_cube_origin = (inv_modelmatrix * vec4(u_cube_origin, 1.0)).xyz;
		vec3 reflectvec_current = CubemapParallaxCorrect(reflectvec, ps_cubevertexpos, local_cube_min, local_cube_max, local_cube_origin);

		vec3 reflectvec_prev;
		if( d_cubemaps == 2 )
		{
			local_cube_min = (inv_modelmatrix * vec4(u_cube_prev_min, 1.0)).xyz;
			local_cube_max = (inv_modelmatrix * vec4(u_cube_prev_max, 1.0)).xyz;
			local_cube_origin = (inv_modelmatrix * vec4(u_cube_prev_origin, 1.0)).xyz;
			reflectvec_prev = CubemapParallaxCorrect(reflectvec, ps_cubevertexpos, local_cube_min, local_cube_max, local_cube_origin);
		}

		vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
		float NdotV = max(dot(v_normal, -view_dir), 0.0);
		vec3 F = FresnelSchlickRoughness(NdotV, F0, mrao.y);
		return GetCubemapPixel(reflectvec_current, reflectvec_prev, mrao.y) * vec4(F * mrao.z, 1.0);
	}
}

void main()
{
	vec2 texCoord = ps_texcoord;
	if (d_bumpmapping == 1 && u_heightscale > 0.0)
	{
		mat3 tbnMatrix = mat3(ps_tangent, ps_binormal, ps_normal);
		mat3 invTBN = transpose(tbnMatrix);
		vec3 viewDirTS = normalize(invTBN * (-ps_vertexpos));
		texCoord = ParallaxMapping(normalmap, ps_texcoord, u_heightscale, viewDirTS);
	}

	vec3 mrao = vec3(0.0, 1.0, 1.0);
	vec4 mraoSample = vec4(0.0, 1.0, 1.0, 1.0);
	vec4 finalColor = vec4(0, 0, 0, 0);

	if( d_mrao == 1 || d_cubemaps >= 1 )
	{
		mraoSample = GetMRAOSample(texCoord);
		mrao = mraoSample.zyx;
	}
	
	// 0 -> main * detail texture * lightmapping
	// 1 -> texture * lightmapping
	// 2 -> texture * lightmap + chrome * lightmap
	$branch shadertype == 0 || shadertype == 1 || shadertype == 2
	$begin
		vec3 v_normal = GetTangentSpaceNormal(texCoord, ps_normal);
		finalColor = CombineTextureLayers(ps_vertexpos, v_normal, mrao, mraoSample.a, texCoord);
		
		vec3 dlightDiffuse = vec3(0.0);
		vec3 specularColor = vec3(0.0);
		vec3 albedo = GetMainTexture(texCoord).rgb;
		
		vec3 eyeNormal = (d_bumpmapping == 1) ? normalize(mat3(ps_tangent, ps_binormal, ps_normal) * v_normal) : normalize(ps_normal);
		
		if (d_csm == 1)
		{
			vec3 csmSpec = vec3(0.0);
			vec3 eyeLightDir = normalize(csm_direction);
			float dp = max(dot(-eyeLightDir, eyeNormal), 0.0);

			if (dp > 0.0)
			{
				vec3 eyeVec = normalize(-ps_vertexpos);
				vec3 halfVec = normalize(-eyeLightDir + eyeVec);
				vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
				vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
				vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

				vec3 csmDiff = kD * csm_light_color.xyz * dp;
				if (d_mrao == 1)
					csmSpec = CookTorranceSpecular(ps_vertexpos, eyeNormal, eyeLightDir, mrao.y, F0) * dp * csm_light_color.xyz;

				float shadowFactor = 1.0;
				if (ps_csm_vertexcoord.w > 0.0)
				{
					vec2 csmUV = ps_csm_vertexcoord.xy / ps_csm_vertexcoord.w;
					if (csmUV.x >= 0.0 && csmUV.x <= 1.0 && csmUV.y >= 0.0 && csmUV.y <= 1.0)
					{
						shadowFactor = GetCSMShadowPCF(ps_csm_vertexcoord.z, csmUV, eyeNormal, csm_shadowmap);
					}
				}

				csmDiff *= shadowFactor;
				csmSpec *= shadowFactor;

				dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, csmDiff);
				specularColor = AddSpecularLight(specularColor, csmSpec);
			}
		}
		
		if(d_numlights >= 1)
		{
			vec3 specLight;
			vec4 lightColor = (light_0_cone_size > 0.0) ? AddProjLight(light_0_radius, light_0_origin, light_0_color.xyz, ps_vertexpos, ps_light_0_vertexcoord, eyeNormal, light_0_projtexture, mrao, albedo, light_0_cone_size, light_0_spotdirection, specLight) : AddPointLight(light_0_radius, light_0_origin, light_0_color.xyz, ps_vertexpos, eyeNormal, mrao, albedo, specLight);
			if( d_light0_shadowmap == 1 )
			{
				float shadowFactor = (light_0_cone_size > 0.0) ? GetProjLightShadowing(light_0_radius, light_0_origin, ps_vertexpos, ps_light_0_vertexcoord, eyeNormal, light_0_shadowmap) : GetPointLightShadowing(light_0_radius, ps_light_0_vertexcoord, light_0_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numlights >= 2)
		{
			vec3 specLight;
			vec4 lightColor = (light_1_cone_size > 0.0) ? AddProjLight(light_1_radius, light_1_origin, light_1_color.xyz, ps_vertexpos, ps_light_1_vertexcoord, eyeNormal, light_1_projtexture, mrao, albedo, light_1_cone_size, light_1_spotdirection, specLight) : AddPointLight(light_1_radius, light_1_origin, light_1_color.xyz, ps_vertexpos, eyeNormal, mrao, albedo, specLight);
			if( d_light1_shadowmap == 1 )
			{
				float shadowFactor = (light_1_cone_size > 0.0) ? GetProjLightShadowing(light_1_radius, light_1_origin, ps_vertexpos, ps_light_1_vertexcoord, eyeNormal, light_1_shadowmap) : GetPointLightShadowing(light_1_radius, ps_light_1_vertexcoord, light_1_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numlights >= 3)
		{
			vec3 specLight;
			vec4 lightColor = (light_2_cone_size > 0.0) ? AddProjLight(light_2_radius, light_2_origin, light_2_color.xyz, ps_vertexpos, ps_light_2_vertexcoord, eyeNormal, light_2_projtexture, mrao, albedo, light_2_cone_size, light_2_spotdirection, specLight) : AddPointLight(light_2_radius, light_2_origin, light_2_color.xyz, ps_vertexpos, eyeNormal, mrao, albedo, specLight);
			if( d_light2_shadowmap == 1 )
			{
				float shadowFactor = (light_2_cone_size > 0.0) ? GetProjLightShadowing(light_2_radius, light_2_origin, ps_vertexpos, ps_light_2_vertexcoord, eyeNormal, light_2_shadowmap) : GetPointLightShadowing(light_2_radius, ps_light_2_vertexcoord, light_2_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numlights >= 4)
		{
			vec3 specLight;
			vec4 lightColor = (light_3_cone_size > 0.0) ? AddProjLight(light_3_radius, light_3_origin, light_3_color.xyz, ps_vertexpos, ps_light_3_vertexcoord, eyeNormal, light_3_projtexture, mrao, albedo, light_3_cone_size, light_3_spotdirection, specLight) : AddPointLight(light_3_radius, light_3_origin, light_3_color.xyz, ps_vertexpos, eyeNormal, mrao, albedo, specLight);
			if( d_light3_shadowmap == 1 )
			{
				float shadowFactor = (light_3_cone_size > 0.0) ? GetProjLightShadowing(light_3_radius, light_3_origin, ps_vertexpos, ps_light_3_vertexcoord, eyeNormal, light_3_shadowmap) : GetPointLightShadowing(light_3_radius, ps_light_3_vertexcoord, light_3_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		
		finalColor.xyz += dlightDiffuse * albedo * 2.0 + specularColor;
		finalColor = finalColor*color;		
		
		if( d_cubemaps >= 1 )
			finalColor.xyz += AddCubemaps(mrao, albedo, texCoord).xyz;
	$end
	// Texture unit 0 only and texunit 0 * 4
	$branch shadertype == 3 || shadertype == 12
	$begin
		finalColor = SampleLightmap(baselightmap[0], ps_lmapcoord[0]);
		
		vec3 dummySpec;
		mat3 dummyTBN = mat3(1.0);
		finalColor += EvaluateExtraLightstyleLayers(vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), dummyTBN, dummySpec);
		
		finalColor *= color;
		
		$branch shadertype == 12
		$begin
			finalColor.xyz *= 4;
		$end
	$end
	// Texture unit 1
	$branch shadertype == 4
	$begin
		finalColor = GetMainTexture(texCoord) * color;
	$end
	// Light alpha
	$branch shadertype == 5
	$begin
		vec3 v_normal = GetTangentSpaceNormal(texCoord, ps_normal);
		vec3 lightDir0 = GetLightDirLayer( lightvecstex[0], ps_lmapcoord[0] );
		vec4 diffuseLight0 = GetDiffuseLightLayer( difflightmap[0], ps_lmapcoord[0] );
		
		finalColor = AddBaseLightLayer(baselightmap[0], diffuseLight0, lightDir0, v_normal, ps_lmapcoord[0]);
		
		vec3 dummySpec;
		mat3 dummyTBN = mat3(1.0);
		finalColor += EvaluateExtraLightstyleLayers(v_normal, vec3(0.0), vec3(0.0), vec3(0.0), dummyTBN, dummySpec);
		
		finalColor.w = finalColor.w * GetMainTexture(texCoord).w;
	$end
	
	// Solid color only
	$branch shadertype == 6
	$begin
		finalColor = vec4(1.0, 1.0, 1.0, 1.0)*color;
	$end
	
	// VSM store, without and with alpha
	$branch shadertype == 7 || shadertype == 8
	$begin
		finalColor = EncodeDepth(ps_vertexpos, light_radius);
		
		$branch shadertype == 8
		$begin
			if(GetMainTexture(texCoord).w < 0.5)
				discard;
		$end
	$end
	
	// Main texture multiplied with detail texture * 2
	$branch shadertype == 9
	$begin
		vec4 tex0 = GetMainTexture(texCoord);
		vec4 tex1 = texture(detailtex, ps_dtexcoord);
		finalColor = tex0*tex1;
		finalColor.xyz = finalColor.xyz*2;
		finalColor = finalColor*color;
	$end
	
	// Decals with alpha holes from world texture
	$branch shadertype == 10
	$begin
		finalColor = GetMainTexture(texCoord);
		vec4 tex1 = texture(detailtex, ps_dtexcoord);
		finalColor.a = finalColor.a*tex1.a;
		finalColor.xyz = (decalalpha * finalColor.xyz) + (1.0 - decalalpha) * vec3(0.5, 0.5, 0.5);
	$end
	
	// Decal
	$branch shadertype == 11
	$begin
		finalColor = GetMainTexture(texCoord);
		finalColor.xyz = (decalalpha * finalColor.xyz) + (1.0 - decalalpha) * vec3(0.5, 0.5, 0.5);
	$end
	
	// CSM store, without and with alpha
	$branch shadertype == 13 || shadertype == 14
	$begin
		finalColor = vec4(1.0);

		$branch shadertype == 14
		$begin
			if(GetMainTexture(texCoord).w < 0.5)
				discard;
		$end
	$end
	
	// If fog is enabled or not
	if( d_fogtype != 0 )
	{
		float fp_fogfactor = CalcFogFactor( ps_vertexpos.xyz, ps_fogcoord, fogparams );
		finalColor.xyz = mix(finalColor.xyz, fogcolor, fp_fogfactor);
	}

	$branch alphatest == 1
	$begin
		if(finalColor.a < 0.5)
			discard;
	$end
	$branch alphatest == 2
	$begin
		finalColor.a = (finalColor.a - 0.5) / max(fwidth(finalColor.a), 0.0001) + 0.5;
	$end

	oColor = finalColor;
}
$end