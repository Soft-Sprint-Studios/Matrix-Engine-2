$global_determinator mrao 0 1
$global_determinator flowmap 0 1
$shader_vertex $begin
#version 130

uniform mat4 projection;
uniform mat4 modelview;

uniform mat4 normalmatrix_v;

uniform mat4 light_0_matrix;
uniform mat4 light_1_matrix;
uniform mat4 light_2_matrix;
uniform mat4 light_3_matrix;
uniform highp int d_numlights;

uniform float texscale;

in vec4 in_position;
in vec2 in_texcoords;
in vec2 in_lightcoords[4];
in vec4 in_styles;
in vec3 in_tangent;
in vec3 in_binormal;
in vec3 in_normal;

out vec4 ps_screencoords;
out vec3 ps_eyecoords;
out vec2 ps_texcoords;
out vec2 ps_lightcoords[4];
flat out vec4 ps_styles;

out vec4 ps_light_0_vertexcoord;
out vec4 ps_light_1_vertexcoord;
out vec4 ps_light_2_vertexcoord;
out vec4 ps_light_3_vertexcoord;

$branch flowmap == 1
$begin
    out vec2 ps_flowcoords;
$end

$branch mrao == 1
$begin
	out vec3 ps_tangent;
	out vec3 ps_binormal;
	out vec3 ps_normal;
$end

void main()
{
	vec4 position = in_position*modelview;
	vec4 eye_position = position*projection;

	ps_screencoords = eye_position;
	ps_eyecoords = position.xyz;
	
	$branch flowmap == 1
    $begin
        ps_flowcoords = in_texcoords;
    $end

	$branch mrao == 1
	$begin
		ps_tangent = (normalmatrix_v*vec4(in_tangent, 0.0)).xyz;
		ps_binormal = (normalmatrix_v*vec4(in_binormal, 0.0)).xyz;
		ps_normal = (normalmatrix_v*vec4(in_normal, 0.0)).xyz;
	$end

	ps_texcoords.x = in_texcoords.x*texscale;
	ps_texcoords.y = in_texcoords.y*texscale;
	
	for (int i = 0; i < 4; i++)
	{
		ps_lightcoords[i] = in_lightcoords[i];
	}
	ps_styles = in_styles;

	if (d_numlights >= 1)
		ps_light_0_vertexcoord = light_0_matrix * in_position;
	if (d_numlights >= 2)
		ps_light_1_vertexcoord = light_1_matrix * in_position;
	if (d_numlights >= 3)
		ps_light_2_vertexcoord = light_2_matrix * in_position;
	if (d_numlights >= 4)
		ps_light_3_vertexcoord = light_3_matrix * in_position;

	gl_Position = eye_position;
}
$end
$shader_fragment 
$determinator fog 0 1
$determinator side 0 1
$determinator rectrefract 0 1
$determinator lightmap_bicubic 0 1
$begin
#version 130
#extension GL_ARB_texture_rectangle : enable

#define M_PI 3.14159265358979323846264338327950288

uniform sampler2D normalMap;
uniform sampler2D lightMap[4];
uniform sampler2D refractMap;
uniform sampler2D reflectMap;
uniform sampler2DRect rectangleRefractMap;
uniform sampler2D diffuseMap[4];
uniform sampler2D lightvecsMap[4];
uniform sampler2D flowMap;

uniform float u_lightstyle_values[256];

uniform highp int d_numlights;
uniform highp int d_light0_shadowmap;
uniform highp int d_light1_shadowmap;
uniform highp int d_light2_shadowmap;
uniform highp int d_light3_shadowmap;

uniform vec3 light_0_origin;
uniform float light_0_radius;
uniform vec4 light_0_color;
uniform sampler2D light_0_projtexture;
uniform float light_0_cone_size;
uniform vec3 light_0_spotdirection;
uniform samplerCube light_0_cubemap;
uniform sampler2D light_0_shadowmap;

uniform vec3 light_1_origin;
uniform float light_1_radius;
uniform vec4 light_1_color;
uniform sampler2D light_1_projtexture;
uniform float light_1_cone_size;
uniform vec3 light_1_spotdirection;
uniform samplerCube light_1_cubemap;
uniform sampler2D light_1_shadowmap;

uniform vec3 light_2_origin;
uniform float light_2_radius;
uniform vec4 light_2_color;
uniform sampler2D light_2_projtexture;
uniform float light_2_cone_size;
uniform vec3 light_2_spotdirection;
uniform samplerCube light_2_cubemap;
uniform sampler2D light_2_shadowmap;

uniform vec3 light_3_origin;
uniform float light_3_radius;
uniform vec4 light_3_color;
uniform sampler2D light_3_projtexture;
uniform float light_3_cone_size;
uniform vec3 light_3_spotdirection;
uniform samplerCube light_3_cubemap;
uniform sampler2D light_3_shadowmap;

uniform mat4 normalmatrix;

uniform vec3 fogcolor;
uniform vec2 fogparams;

uniform float fresnel;
uniform float time;
uniform float strength;
uniform float lightstrength;
uniform float wavefresnelstrength;
uniform float flowSpeed;

uniform vec2 scroll;
uniform vec2 rectscale;

in vec4 ps_screencoords;
in vec3 ps_eyecoords;
in vec2 ps_texcoords;
in vec2 ps_lightcoords[4];
flat in vec4 ps_styles;

in vec4 ps_light_0_vertexcoord;
in vec4 ps_light_1_vertexcoord;
in vec4 ps_light_2_vertexcoord;
in vec4 ps_light_3_vertexcoord;

$branch flowmap == 1
$begin
    in vec2 ps_flowcoords;
$end

$branch mrao == 1
$begin
	in vec3 ps_tangent;
	in vec3 ps_binormal;
	in vec3 ps_normal;
$end

out vec4 oColor;

float SplineFraction( float value, float scale )
{
	float valueSquared;

	value = scale * value;
	valueSquared = value * value;

	// Nice little ease-in, ease-out spline-like curve
	return 3 * valueSquared - 2 * valueSquared * value;
}

// Bicubic lightmapping code based on godot engine implementation
float w0(float a) 
{
	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
}

float w1(float a) 
{
	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
}

float w2(float a) 
{
	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
}

float w3(float a) 
{
	return (1.0 / 6.0) * (a * a * a);
}

float g0(float a) 
{
	return w0(a) + w1(a);
}

float g1(float a) 
{
	return w2(a) + w3(a);
}

float h0(float a) 
{
	return -1.0 + w1(a) / (w0(a) + w1(a));
}

float h1(float a) 
{
	return 1.0 + w3(a) / (w2(a) + w3(a));
}

vec4 texture2D_bicubic(sampler2D tex, vec2 uv, vec2 texture_size) 
{
	vec2 texel_size = vec2(1.0) / texture_size;

	uv = uv * texture_size + vec2(0.5);

	vec2 iuv = floor(uv);
	vec2 fuv = fract(uv);

	float g0x = g0(fuv.x);
	float g1x = g1(fuv.x);
	float h0x = h0(fuv.x);
	float h1x = h1(fuv.x);
	float h0y = h0(fuv.y);
	float h1y = h1(fuv.y);

	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;

	return (g0(fuv.y) * (g0x * texture(tex, p0) + g1x * texture(tex, p1))) +
			(g1(fuv.y) * (g0x * texture(tex, p2) + g1x * texture(tex, p3)));
}

vec4 SampleLightmap(sampler2D tex, vec2 uv) 
{
	$branch lightmap_bicubic == 1
	$begin
		return texture2D_bicubic(tex, uv, vec2(textureSize(tex, 0)));
	$end
	$branch lightmap_bicubic == 0
	$begin
		return texture(tex, uv);
	$end
}

float LinearStep(float in1, float in2, float pmax)  
{  
	float value = (pmax-in1)/(in2-in1);
	return clamp(value, 0.0, 1.0);
}

float ReduceLightBleeding(float p_max, float Amount)  
{    
	return LinearStep(Amount, 1, p_max);  
}

float DepthTestCube( float depthcoord, samplerCube shadowmap, vec3 coord )
{
	vec4 momments = texture(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32.0;
	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0.0);
	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

float DepthTestProj( float depthcoord, sampler2D shadowmap, vec4 coord )
{
	vec4 momments = textureProj(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32.0;
	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0.0);
	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
	float a = roughness * roughness;
	float a2 = a * a;
	float NdotH = max(dot(N, H), 0.0);
	float NdotH2 = NdotH * NdotH;

	float nom = a2;
	float denom = (NdotH2 * (a2 - 1.0) + 1.0);
	denom = M_PI * denom * denom;

	return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
	float r = roughness + 1.0;
	float k = (r * r) / 8.0;

	float nom = NdotV;
	float denom = NdotV * (1.0 - k) + k;

	return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float ggx1 = GeometrySchlickGGX(NdotV, roughness);
	float ggx2 = GeometrySchlickGGX(NdotL, roughness);

	return ggx1 * ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
	return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 CookTorranceSpecular( vec3 v_origin, vec3 v_normal, vec3 lightDir, float roughness, vec3 F0 )
{
	vec3 eyeVec = normalize( -v_origin );
	vec3 lightVec = normalize( -lightDir );
	vec3 halfVec = normalize( lightVec + eyeVec );
	
	float NDF = DistributionGGX(v_normal, halfVec, roughness);
	float G = GeometrySmith(v_normal, eyeVec, lightVec, roughness);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	
	float NdotV = max(dot(v_normal, eyeVec), 0.0);
	float NdotL = max(dot(v_normal, lightVec), 0.0);
	
	float denom = 4.0 * NdotV * NdotL + 0.0001;
	
	return (NDF * G * F) / denom;
}

vec4 AddPointLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec3 v_normal, vec3 mrao, vec3 albedo, out vec3 specOut )
{
	float rad = l_radius * l_radius;
	vec3 dir = l_origin - v_origin;
	
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	
	dir = normalize(dir);
	attn = clamp(attn, 0.0, 1.0);
	
	float dp = dot(dir, v_normal);
	attn = max(dp, 0.0)*attn;
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * attn * l_color;
	
	specOut = vec3(0.0);
	$branch mrao == 1
	$begin
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * l_color;
	$end
	
	outColor.w = 0.0;
	return outColor;
}

float GetPointLightShadowing( float l_radius, vec4 v_coord, samplerCube l_shadowmap )
{
	float fldistance = clamp((length(v_coord.xyz)/l_radius), 0.0, 1.0);
	float flresult = DepthTestCube(fldistance, l_shadowmap, normalize(v_coord.xyz));
	return ReduceLightBleeding(flresult, 0.4);
}

vec4 AddProjLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec4 v_coord, vec3 v_normal, sampler2D l_texture, vec3 mrao, vec3 albedo, float l_cone_size, vec3 l_spotdirection, out vec3 specOut )
{
	float rad = l_radius*l_radius;
	vec3 dir = l_origin-v_origin;
	
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	attn = clamp(attn, 0.0, 1.0);
	
	dir = normalize(dir);
	float dp = max(dot(dir, v_normal), 0.0);
	
	vec4 texColor = textureProj(l_texture, v_coord);
	
	float spotcos = cos((l_cone_size*2.0)*0.3*(M_PI*2.0/360.0));
	
	vec3 spotdirection = normalize(l_spotdirection);
	float spotatten = -dot(spotdirection, dir);
	
	spotatten = max(spotatten, spotcos);
	float spotfactor = (spotatten - spotcos)/(1.0 - spotcos);
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * texColor.xyz * attn * l_color * dp * spotfactor;
	
	specOut = vec3(0.0);
	$branch mrao == 1
	$begin
		float lightStrength = (texColor.x + texColor.y + texColor.z) / 3.0;
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * dp * lightStrength * spotfactor * l_color;
	$end
	
	outColor.w = 0.0;
	return outColor;
}

float GetProjLightShadowing( float l_radius, vec3 l_origin, vec3 v_origin, vec4 v_coord, vec3 v_normal, sampler2D l_shadowmap )
{
	float fldistance = clamp((length(l_origin-v_origin)/l_radius), 0.0, 1.0);
	float flresult = DepthTestProj(fldistance, l_shadowmap, v_coord);
	return ReduceLightBleeding(flresult, 0.4);
}

vec3 AddDiffuseDynamicLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

vec3 AddSpecularLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

vec3 GetLightDirLayer( sampler2D vecsLightmap, vec2 lmapcoord )
{
	$branch mrao == 1
	$begin
		return normalize((2.0 * SampleLightmap(vecsLightmap, lmapcoord).xyz) - 1.0);
	$end
	$branch mrao == 0
	$begin
		return vec3(0.0);
	$end
}

vec4 GetDiffuseLightLayer( sampler2D diffuseTexture, vec2 lmapcoord )
{
	$branch mrao == 1
	$begin
		return SampleLightmap(diffuseTexture, lmapcoord);
	$end
	$branch mrao == 0
	$begin
		return vec4(0.0);
	$end
}

vec4 AddBaseLightLayer( sampler2D ambLightmap, vec4 diffuseColor, vec3 lightDir, vec3 v_normal, vec2 lmapcoord )
{
	$branch mrao == 0
	$begin
		vec4 lightmapColor = SampleLightmap(ambLightmap, lmapcoord);
		return lightmapColor;
	$end
	$branch mrao == 1
	$begin
		vec4 ambientColor = SampleLightmap(ambLightmap, lmapcoord);
		vec4 finalColor = ambientColor + diffuseColor * max(dot(lightDir, v_normal), 0.0);
		return finalColor;
	$end
}

$branch mrao == 1
$begin
float CalcShininess( vec3 v_origin, vec3 v_normal, vec3 l_origin )
{
	vec3 halfVec = normalize(l_origin - v_origin);
	return max(dot(halfVec, v_normal), 0.0);
}

vec4 GetLightmappedSpecularLayer( vec3 v_origin, vec3 v_normal, sampler2D vecsMap, sampler2D diffMap, vec2 lmapcoord )
{
	vec3 lightDir = (2.0 * SampleLightmap(vecsMap, lmapcoord).xyz) - 1.0;
	lightDir = normalize(lightDir);

	vec4 lightDiffuse = SampleLightmap(diffMap, lmapcoord);
	
	mat3 tbnMatrix = mat3(ps_tangent, ps_binormal, ps_normal);
	vec3 eyeSpaceDir = normalize(tbnMatrix * vec3(lightDir[0], -lightDir[1], lightDir[2]));
	
	float shineFactor = CalcShininess(normalize(v_origin), v_normal, eyeSpaceDir);
	
	// Dielectric water surface (smooth roughness ~0.1, dielectric F0 ~0.02)
	vec3 specularValue = CookTorranceSpecular(v_origin, v_normal, -eyeSpaceDir, 0.1, vec3(0.02));
	
	vec4 finalColor = vec4(specularValue, 1.0) * lightDiffuse * shineFactor;
	return finalColor;
}
$end

vec4 EvaluateExtraLightstyles( vec3 v_normal, vec3 v_origin, out vec4 extraSpecular )
{
	vec4 extraColor = vec4(0.0);
	extraSpecular = vec4(0.0);

	for (int i = 1; i < 4; i++)
	{
		int styleIndex = int(ps_styles[i] + 0.5);
		if (styleIndex >= 0 && styleIndex < 254)
		{
			float styleVal = u_lightstyle_values[styleIndex];
			if (styleVal > 0.0)
			{
				vec3 dir = GetLightDirLayer(lightvecsMap[i], ps_lightcoords[i]);
				vec4 diff = GetDiffuseLightLayer(diffuseMap[i], ps_lightcoords[i]);
				extraColor += AddBaseLightLayer(lightMap[i], diff, dir, v_normal, ps_lightcoords[i]) * styleVal;

				$branch mrao == 1
				$begin
					extraSpecular += GetLightmappedSpecularLayer(v_origin, v_normal, lightvecsMap[i], diffuseMap[i], ps_lightcoords[i]) * styleVal;
				$end
			}
		}
	}

	return extraColor;
}

void main()
{
	vec4 finalColor;

	vec2 texcoord = ps_texcoords + scroll;
	
	$branch flowmap == 1
    $begin
        vec2 flowDirection = texture2D(flowMap, ps_flowcoords).xy * 2.0 - 1.0;
        texcoord += flowDirection * time * flowSpeed;
    $end

	vec2 texc0 = vec2(texcoord.x+time*0.20, texcoord.y+time*0.15);
	vec2 texc1 = vec2(texcoord.x-time*0.13, texcoord.y+time*0.11);

	vec4 norm1 = texture(normalMap, texc0);
	vec4 norm2 = texture(normalMap, texc1);

	vec2 texc2 = vec2(texcoord.x+time*0.17, texcoord.y+time*0.15);
	vec2 texc3 = vec2(texcoord.x-time*0.14, texcoord.y-time*0.16);

	vec4 norm3 = texture(normalMap, texc2);
	vec4 norm4 = texture(normalMap, texc3);	

	vec3 norm_combine = normalize((norm1*0.25 + norm2*0.25 + norm3*0.25 + norm4*0.25).xyz * 2.0 - 1.0);

	$branch side == 0
	$begin
		vec2 coordUV1 = (ps_screencoords.xy / (2*ps_screencoords.w) ) + 0.5 + norm_combine.xy*0.1*strength;
		$branch rectrefract == 1
		$begin
			coordUV1 *= rectscale;
			vec4 refractcolor = texture(rectangleRefractMap, coordUV1);
		$end
		$branch rectrefract == 0
		$begin
			vec4 refractcolor = texture(refractMap, coordUV1);
		$end
	
		vec3 vnormal_texture = normalize((normalmatrix*vec4(norm_combine, 0)).xyz);
		vec3 lightDir0 = GetLightDirLayer( lightvecsMap[0], ps_lightcoords[0] );
		vec4 diffuseLight0 = GetDiffuseLightLayer( diffuseMap[0], ps_lightcoords[0] );
		vec4 lightmapcolor = AddBaseLightLayer(lightMap[0], diffuseLight0, lightDir0, vnormal_texture, ps_lightcoords[0]);

		vec4 extraSpecular = vec4(0.0);
		vec4 extraLight = EvaluateExtraLightstyles(vnormal_texture, ps_eyecoords, extraSpecular);
		lightmapcolor += extraLight;

		finalColor = refractcolor + lightmapcolor * lightstrength;
		
		$branch mrao == 1
		$begin
			finalColor += GetLightmappedSpecularLayer( ps_eyecoords, vnormal_texture, lightvecsMap[0], diffuseMap[0], ps_lightcoords[0] ) + extraSpecular;
		$end
	$end
	$branch side == 1
	$begin
		vec2 coordUV1 = (ps_screencoords.xy / (2*ps_screencoords.w) ) + 0.5 + norm_combine.xy*0.1*strength;
		$branch rectrefract == 1
		$begin
			coordUV1 *= rectscale;
			vec4 refractcolor = texture(rectangleRefractMap, coordUV1);
		$end
		$branch rectrefract == 0
		$begin
			vec4 refractcolor = texture(refractMap, coordUV1);
		$end

		vec2 coordUV2 = (vec2(ps_screencoords.x, -ps_screencoords.y) / (2*ps_screencoords.w) ) + 0.5 + norm_combine.xy*0.1*strength;
		vec4 reflectcolor = texture(reflectMap, coordUV2);

		vec3 fresnel_normal = norm_combine * wavefresnelstrength + (1.0 - wavefresnelstrength)*vec3(0, 0, 1);

		vec3 vnormal_texture = normalize((normalmatrix*vec4(fresnel_normal, 0)).xyz);
		
		float fresnelterm = clamp(dot(-normalize(ps_eyecoords), vnormal_texture)*1.3*fresnel, 0.0, 0.97 );
		vec4 combinedColor = mix(reflectcolor, refractcolor, fresnelterm);

		vec3 lightDir0 = GetLightDirLayer( lightvecsMap[0], ps_lightcoords[0] );
		vec4 diffuseLight0 = GetDiffuseLightLayer( diffuseMap[0], ps_lightcoords[0] );
		vec4 lightmapcolor = AddBaseLightLayer(lightMap[0], diffuseLight0, lightDir0, vnormal_texture, ps_lightcoords[0]);

		vec4 extraSpecular = vec4(0.0);
		vec4 extraLight = EvaluateExtraLightstyles(vnormal_texture, ps_eyecoords, extraSpecular);
		lightmapcolor += extraLight;

		finalColor = combinedColor + lightmapcolor * lightstrength;
		
		$branch mrao == 1
		$begin
			finalColor += GetLightmappedSpecularLayer( ps_eyecoords, vnormal_texture, lightvecsMap[0], diffuseMap[0], ps_lightcoords[0] ) + extraSpecular;
		$end
	$end

	vec3 dlightDiffuse = vec3(0.0);
	vec3 specularColor = vec3(0.0);
	vec3 mrao_val = vec3(0.0, 0.1, 1.0);
	vec3 albedo_val = vec3(1.0);

	vec3 eyeNormal = normalize((normalmatrix * vec4(norm_combine, 0.0)).xyz);

	if(d_numlights >= 1)
	{
		vec3 specLight;
		vec4 lightColor = (light_0_cone_size > 0.0) ? AddProjLight(light_0_radius, light_0_origin, light_0_color.xyz, ps_eyecoords, ps_light_0_vertexcoord, eyeNormal, light_0_projtexture, mrao_val, albedo_val, light_0_cone_size, light_0_spotdirection, specLight) : AddPointLight(light_0_radius, light_0_origin, light_0_color.xyz, ps_eyecoords, eyeNormal, mrao_val, albedo_val, specLight);
		if( d_light0_shadowmap == 1 )
		{
			float shadowFactor = (light_0_cone_size > 0.0) ? GetProjLightShadowing(light_0_radius, light_0_origin, ps_eyecoords, ps_light_0_vertexcoord, eyeNormal, light_0_shadowmap) : GetPointLightShadowing(light_0_radius, ps_light_0_vertexcoord, light_0_cubemap);
			lightColor *= shadowFactor;
			specLight *= shadowFactor;
		}
		dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
		specularColor = AddSpecularLight(specularColor, specLight);
	}
	if(d_numlights >= 2)
	{
		vec3 specLight;
		vec4 lightColor = (light_1_cone_size > 0.0) ? AddProjLight(light_1_radius, light_1_origin, light_1_color.xyz, ps_eyecoords, ps_light_1_vertexcoord, eyeNormal, light_1_projtexture, mrao_val, albedo_val, light_1_cone_size, light_1_spotdirection, specLight) : AddPointLight(light_1_radius, light_1_origin, light_1_color.xyz, ps_eyecoords, eyeNormal, mrao_val, albedo_val, specLight);
		if( d_light1_shadowmap == 1 )
		{
			float shadowFactor = (light_1_cone_size > 0.0) ? GetProjLightShadowing(light_1_radius, light_1_origin, ps_eyecoords, ps_light_1_vertexcoord, eyeNormal, light_1_shadowmap) : GetPointLightShadowing(light_1_radius, ps_light_1_vertexcoord, light_1_cubemap);
			lightColor *= shadowFactor;
			specLight *= shadowFactor;
		}
		dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
		specularColor = AddSpecularLight(specularColor, specLight);
	}
	if(d_numlights >= 3)
	{
		vec3 specLight;
		vec4 lightColor = (light_2_cone_size > 0.0) ? AddProjLight(light_2_radius, light_2_origin, light_2_color.xyz, ps_eyecoords, ps_light_2_vertexcoord, eyeNormal, light_2_projtexture, mrao_val, albedo_val, light_2_cone_size, light_2_spotdirection, specLight) : AddPointLight(light_2_radius, light_2_origin, light_2_color.xyz, ps_eyecoords, eyeNormal, mrao_val, albedo_val, specLight);
		if( d_light2_shadowmap == 1 )
		{
			float shadowFactor = (light_2_cone_size > 0.0) ? GetProjLightShadowing(light_2_radius, light_2_origin, ps_eyecoords, ps_light_2_vertexcoord, eyeNormal, light_2_shadowmap) : GetPointLightShadowing(light_2_radius, ps_light_2_vertexcoord, light_2_cubemap);
			lightColor *= shadowFactor;
			specLight *= shadowFactor;
		}
		dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
		specularColor = AddSpecularLight(specularColor, specLight);
	}
	if(d_numlights >= 4)
	{
		vec3 specLight;
		vec4 lightColor = (light_3_cone_size > 0.0) ? AddProjLight(light_3_radius, light_3_origin, light_3_color.xyz, ps_eyecoords, ps_light_3_vertexcoord, eyeNormal, light_3_projtexture, mrao_val, albedo_val, light_3_cone_size, light_3_spotdirection, specLight) : AddPointLight(light_3_radius, light_3_origin, light_3_color.xyz, ps_eyecoords, eyeNormal, mrao_val, albedo_val, specLight);
		if( d_light3_shadowmap == 1 )
		{
			float shadowFactor = (light_3_cone_size > 0.0) ? GetProjLightShadowing(light_3_radius, light_3_origin, ps_eyecoords, ps_light_3_vertexcoord, eyeNormal, light_3_shadowmap) : GetPointLightShadowing(light_3_radius, ps_light_3_vertexcoord, light_3_cubemap);
			lightColor *= shadowFactor;
			specLight *= shadowFactor;
		}
		dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
		specularColor = AddSpecularLight(specularColor, specLight);
	}

	finalColor.xyz += dlightDiffuse * lightstrength + specularColor;
	
	$branch fog == 1
	$begin
		float fogcoord = length(ps_eyecoords);
		
		float fogfactor = (fogparams.x - fogcoord)*fogparams.y;
		fogfactor = 1.0-SplineFraction(clamp(fogfactor, 0.0, 1.0), 1.0);
		
		finalColor.xyz = mix(finalColor.xyz, fogcolor, fogfactor);
	$end

	oColor = finalColor;
}
$end