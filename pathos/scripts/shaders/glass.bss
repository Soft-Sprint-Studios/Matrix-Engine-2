$global_determinator fog 0 1
$shader_vertex $begin
#version 460

uniform mat4 projection;
uniform mat4 modelview;
uniform mat4 normalmatrix;

in vec4 in_position;
in vec3 in_tangent;
in vec3 in_binormal;
in vec2 in_texcoord;

out vec2 ps_texcoord;
out vec4 ps_screenpos;
out vec3 ps_tangent;
out vec3 ps_binormal;
out vec3 ps_vertexpos;

void main()
{
	vec4 position = in_position * modelview;
	ps_vertexpos = position.xyz;

	ps_tangent = normalize((normalmatrix * vec4(in_tangent, 0.0)).xyz);
	ps_binormal = normalize((normalmatrix * vec4(in_binormal, 0.0)).xyz);

	ps_texcoord = in_texcoord;

	vec4 finalPosition = position * projection;
	ps_screenpos = finalPosition;
	gl_Position = finalPosition;
}
$end

$shader_fragment $begin
#version 460

uniform sampler2D s_refractTex;
uniform sampler2D s_normalMap;

uniform vec4 u_glassParams;
uniform vec3 fogcolor;
uniform vec2 fogparams;

in vec2 ps_texcoord;
in vec4 ps_screenpos;
in vec3 ps_tangent;
in vec3 ps_binormal;
in vec3 ps_vertexpos;

out vec4 oColor;

float SplineFraction( float value, float scale )
{
	float valueSquared;

	value = scale * value;
	valueSquared = value * value;

	// Nice little ease-in, ease-out spline-like curve
	return 3 * valueSquared - 2 * valueSquared * value;
}

void main()
{
	vec2 screenUV = (ps_screenpos.xy / ps_screenpos.w) * 0.5 + 0.5;

	vec3 tN = normalize(ps_tangent);
	vec3 tB = normalize(ps_binormal);

	vec3 normalSample = texture(s_normalMap, ps_texcoord).rgb * 2.0 - 1.0;
	vec2 offset = (tN.xy * normalSample.x + tB.xy * normalSample.y) * u_glassParams.x;
	vec4 finalColor = texture(s_refractTex, clamp(screenUV + offset, 0.0, 1.0));

	$branch fog == 1
	$begin
		float fogcoord = length(ps_vertexpos);
		float fogfactor = (fogparams.x - fogcoord) * fogparams.y;
		fogfactor = 1.0 - SplineFraction(clamp(fogfactor, 0.0, 1.0), 1.0);
		finalColor.xyz = mix(finalColor.xyz, fogcolor, fogfactor);
	$end

	oColor = vec4(finalColor.rgb, 1.0);
}
$end