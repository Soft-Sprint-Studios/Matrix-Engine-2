$shader_vertex $begin
#version 130

uniform mat4 projection;
uniform mat4 modelview;
uniform vec2 tc_scale;

in vec4 in_position;
in vec2 in_texcoord;

out vec2 ps_texcoord;

void main()
{
	ps_texcoord = in_texcoord*tc_scale;
	vec4 position = in_position*modelview;;
	gl_Position = position*projection;
}
$end
$shader_fragment 
$determinator pp_type 0 18
$begin
#version 130
#extension GL_ARB_texture_rectangle : enable
uniform sampler2DRect texture0rect;

uniform vec4 u_color;
uniform float screenwidth;
uniform float screenheight;

uniform vec2 offsetdivider;

uniform float darken_steps;
uniform float brighten_multiplier;
uniform float blur_brightness;
uniform int blur_radius;
uniform float brightness_treshold;
uniform float grainamount;
uniform float u_exposure;

$branch pp_type == 0
$begin
uniform float gamma;
$end
$branch pp_type == 3
$begin
uniform float offset;
$end
$branch pp_type == 4
$begin
	uniform sampler2DRect blurtextureRect;
$end
$branch pp_type == 15 || pp_type == 16
$begin
	uniform sampler2D normal2dTexture;
$end

in vec2 ps_texcoord;
out vec4 oColor;

$branch pp_type == 6
$begin
uniform float timer;

const float permTexUnit = 1.0/256.0;		// Perm texture texel-size
const float permTexUnitHalf = 0.5/256.0;	// Half perm texture texel-size

float grainsize = 1.6; //grain particle size (1.5 - 2.5)
float lumamount = 1.0; //
float coloramount = 0.6;

//a random texture generator, but you can also use a pre-computed perturbation texture
vec4 rnm(in vec2 tc) 
{
    float noise =  sin(dot(tc + vec2(timer,timer),vec2(12.9898,78.233))) * 43758.5453;

	float noiseR =  fract(noise)*2.0-1.0;
	float noiseG =  fract(noise*1.2154)*2.0-1.0; 
	float noiseB =  fract(noise*1.3453)*2.0-1.0;
	float noiseA =  fract(noise*1.3647)*2.0-1.0;
	
	return vec4(noiseR,noiseG,noiseB,noiseA);
}

float fade(in float t) {
	return t*t*t*(t*(t*6.0-15.0)+10.0);
}

float pnoise3D(in vec3 p)
{
	vec3 pi = permTexUnit*floor(p)+permTexUnitHalf; // Integer part, scaled so +1 moves permTexUnit texel
	// and offset 1/2 texel to sample texel centers
	vec3 pf = fract(p);     // Fractional part for interpolation

	// Noise contributions from (x=0, y=0), z=0 and z=1
	float perm00 = rnm(pi.xy).a ;
	vec3  grad000 = rnm(vec2(perm00, pi.z)).rgb * 4.0 - 1.0;
	float n000 = dot(grad000, pf);
	vec3  grad001 = rnm(vec2(perm00, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n001 = dot(grad001, pf - vec3(0.0, 0.0, 1.0));

	// Noise contributions from (x=0, y=1), z=0 and z=1
	float perm01 = rnm(pi.xy + vec2(0.0, permTexUnit)).a ;
	vec3  grad010 = rnm(vec2(perm01, pi.z)).rgb * 4.0 - 1.0;
	float n010 = dot(grad010, pf - vec3(0.0, 1.0, 0.0));
	vec3  grad011 = rnm(vec2(perm01, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n011 = dot(grad011, pf - vec3(0.0, 1.0, 1.0));

	// Noise contributions from (x=1, y=0), z=0 and z=1
	float perm10 = rnm(pi.xy + vec2(permTexUnit, 0.0)).a ;
	vec3  grad100 = rnm(vec2(perm10, pi.z)).rgb * 4.0 - 1.0;
	float n100 = dot(grad100, pf - vec3(1.0, 0.0, 0.0));
	vec3  grad101 = rnm(vec2(perm10, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n101 = dot(grad101, pf - vec3(1.0, 0.0, 1.0));

	// Noise contributions from (x=1, y=1), z=0 and z=1
	float perm11 = rnm(pi.xy + vec2(permTexUnit, permTexUnit)).a ;
	vec3  grad110 = rnm(vec2(perm11, pi.z)).rgb * 4.0 - 1.0;
	float n110 = dot(grad110, pf - vec3(1.0, 1.0, 0.0));
	vec3  grad111 = rnm(vec2(perm11, pi.z + permTexUnit)).rgb * 4.0 - 1.0;
	float n111 = dot(grad111, pf - vec3(1.0, 1.0, 1.0));

	// Blend contributions along x
	vec4 n_x = mix(vec4(n000, n001, n010, n011), vec4(n100, n101, n110, n111), fade(pf.x));

	// Blend contributions along y
	vec2 n_xy = mix(n_x.xy, n_x.zw, fade(pf.y));

	// Blend contributions along z
	float n_xyz = mix(n_xy.x, n_xy.y, fade(pf.z));

	// We're done, return the final noise value.
	return n_xyz;
}

//2d coordinate orientation thing
vec2 coordRot(in vec2 tc, in float angle)
{
	float aspect = screenwidth/screenheight;
	float rotX = ((tc.x*2.0-1.0)*aspect*cos(angle)) - ((tc.y*2.0-1.0)*sin(angle));
	float rotY = ((tc.y*2.0-1.0)*cos(angle)) + ((tc.x*2.0-1.0)*aspect*sin(angle));
	rotX = ((rotX/aspect)*0.5+0.5);
	rotY = rotY*0.5+0.5;
	return vec2(rotX,rotY);
}
$end

vec4 texture0Func( vec2 texcoord )
{
	return texture(texture0rect, texcoord);
}
$branch pp_type == 4
$begin
	vec4 textureBlurFunc( vec2 texcoord )
	{
		return texture(blurtextureRect, texcoord);
	}
$end
$branch pp_type == 12
$begin
uniform float chromaticStrength;
$end
$branch pp_type == 13
$begin
uniform float BWStrength;
$end
$branch pp_type == 14
$begin
uniform float vignetteStrength;
uniform float vignetteRadius;
$end
$branch pp_type == 17
$begin
vec3 aces(vec3 x) 
{
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}
$end
void main()
{
	$branch pp_type == 0
	$begin
		vec4 color = texture0Func(ps_texcoord);
		color.rgb = max(vec3(0.0), color.rgb) * u_exposure;
		for(int i = 0; i < 4; i++)
			oColor[i] = pow(color[i], 1.0/gamma);
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 1
	$begin
		float offset[5] = float[]( 0.0, 1.0, 2.0, 3.0, 4.0 );
		float weight[5] = float[]( 0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162 );
		
		vec4 outcolor = texture0Func(ps_texcoord)*weight[0];
		for(int i = 1; i < 5; i++)
		{
			vec2 tc1 = vec2(clamp(ps_texcoord.x + offset[i]/offsetdivider.x, 0.0, screenwidth - 1.0), ps_texcoord.y);
			vec2 tc2 = vec2(clamp(ps_texcoord.x - offset[i]/offsetdivider.y, 0.0, screenwidth - 1.0), ps_texcoord.y);
			outcolor += texture0Func(tc1)*weight[i];
			outcolor += texture0Func(tc2)*weight[i];
		}
		oColor = outcolor * u_color * blur_brightness;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 2
	$begin
		float offset[5] = float[]( 0.0, 1.0, 2.0, 3.0, 4.0 );
		float weight[5] = float[]( 0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162 );
	
		vec4 outcolor = texture0Func(ps_texcoord)*weight[0];
		for(int i = 1; i < 5; i++)
		{
			vec2 tc1 = vec2(ps_texcoord.x, clamp(ps_texcoord.y + offset[i]/offsetdivider.x, 0.0, screenheight - 1.0));
			vec2 tc2 = vec2(ps_texcoord.x, clamp(ps_texcoord.y - offset[i]/offsetdivider.y, 0.0, screenheight - 1.0));
			outcolor += texture0Func(tc1)*weight[i];
			outcolor += texture0Func(tc2)*weight[i];
		}
		oColor = outcolor * u_color * blur_brightness;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 3
	$begin
		vec2 texSize = vec2(textureSize(texture0rect));
		vec2 texc = ps_texcoord;
		texc.x += sin(texc.y * 0.03 + offset) * 10.0 * u_color.a;
		texc = clamp(texc, vec2(0.5), texSize - vec2(0.5));
	
		vec4 texColor = texture(texture0rect, texc);
		oColor = vec4(max(vec3(0.0), texColor.rgb * u_color.rgb), 1.0);
	$end
	$branch pp_type == 4
	$begin
		vec4 maintex = texture0Func(ps_texcoord);
		vec4 blurtex = textureBlurFunc(ps_texcoord);
		oColor = maintex*(1.0-u_color.a)+blurtex*(u_color.a);
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 5
	$begin
		oColor = u_color;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 6
	$begin
		vec2 norm_texcoords = vec2(ps_texcoord.x/screenwidth, ps_texcoord.y/screenheight);
		
		vec3 rotOffset = vec3(1.425,3.892,5.835); //rotation offset values	
		vec2 rotCoordsR = coordRot(norm_texcoords, timer*0.25 + rotOffset.x);
		vec2 rotCoordsG = coordRot(norm_texcoords, timer*0.25 + rotOffset.y);
		vec2 rotCoordsB = coordRot(norm_texcoords, timer*0.25 + rotOffset.z);
		
		vec3 noise;
		noise.r = vec3(pnoise3D(vec3(rotCoordsR*vec2(screenwidth/grainsize,screenheight/grainsize),0.0))).r;
		noise.g = mix(noise.r,pnoise3D(vec3(rotCoordsG*vec2(screenwidth/grainsize,screenheight/grainsize),1.0)), coloramount);
		noise.b = mix(noise.r,pnoise3D(vec3(rotCoordsB*vec2(screenwidth/grainsize,screenheight/grainsize),2.0)), coloramount);
		
		vec3 col = texture0Func(ps_texcoord).rgb;

		//noisiness response curve based on scene luminance
		vec3 lumcoeff = vec3(0.299,0.587,0.114);
		float luminance = mix(0.0,dot(col, lumcoeff),lumamount);
		luminance = clamp(luminance, 0.25, 0.75);
		float lum = smoothstep(0.2,0.0,luminance);
		lum += luminance;

		noise = mix(noise,vec3(0.0),pow(lum,4.0));
		col = max(vec3(0.0), col + noise * grainamount);
	   
		oColor = vec4(col, 1.0);	
	$end
	$branch pp_type == 7
	$begin
		oColor = texture0Func(ps_texcoord);
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 8
	$begin
		vec3 textureColor = max(vec3(0.0), texture0Func(ps_texcoord).xyz * brighten_multiplier);
		
		float brightness = dot(textureColor, vec3(0.2126, 0.7152, 0.0722));
		brightness = clamp(brightness, 0.0, 1.0);
		
		float safeThreshold = max(0.0001, brightness_treshold);
		float amount = (brightness / safeThreshold);
		float darken = pow(max(0.0001, brightness), max(1.0, darken_steps));
		
		oColor.xyz = max(vec3(0.0), textureColor * amount * darken);
		oColor.w = 1.0;
	$end
	$branch pp_type == 9
	$begin
		oColor = texture0Func(ps_texcoord) * brighten_multiplier;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 10
	$begin
		float blur_fraction = 1.0f / (blur_radius*2);
		
		vec4 outcolor = texture0Func(ps_texcoord)*blur_fraction;
		for(int i = 1; i < blur_radius; i++)
		{
			vec2 tc1 = vec2(clamp(ps_texcoord.x + i/offsetdivider.x, 0.0, screenwidth - 1.0), ps_texcoord.y);
			vec2 tc2 = vec2(clamp(ps_texcoord.x - i/offsetdivider.y, 0.0, screenwidth - 1.0), ps_texcoord.y);
			outcolor += texture0Func(tc1)*blur_fraction;
			outcolor += texture0Func(tc2)*blur_fraction;
		}
		oColor = outcolor * u_color * blur_brightness;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 11
	$begin
		float blur_fraction = 1.0f / (blur_radius*2);
		
		vec4 outcolor = texture0Func(ps_texcoord)*blur_fraction;
		for(int i = 1; i < blur_radius; i++)
		{
			vec2 tc1 = vec2(ps_texcoord.x, clamp(ps_texcoord.y + i/offsetdivider.x, 0.0, screenheight - 1.0));
			vec2 tc2 = vec2(ps_texcoord.x, clamp(ps_texcoord.y - i/offsetdivider.y, 0.0, screenheight - 1.0));
			outcolor += texture0Func(tc1)*blur_fraction;
			outcolor += texture0Func(tc2)*blur_fraction;
		}
		oColor = outcolor * u_color * blur_brightness;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	$end
	$branch pp_type == 12
    $begin
		vec2 offsetR = vec2(chromaticStrength * 1000.0 / screenwidth, 0.0);
		vec2 offsetG = vec2(-chromaticStrength * 1000.0 / screenwidth, 0.0);
		vec2 offsetB = vec2(0.0, chromaticStrength * 1000.0 / screenheight);
		vec4 colorR = texture0Func(clamp(ps_texcoord + offsetR, vec2(0.0), vec2(screenwidth - 1.0, screenheight - 1.0)));
		vec4 colorG = texture0Func(clamp(ps_texcoord + offsetG, vec2(0.0), vec2(screenwidth - 1.0, screenheight - 1.0)));
		vec4 colorB = texture0Func(clamp(ps_texcoord + offsetB, vec2(0.0), vec2(screenwidth - 1.0, screenheight - 1.0)));
		oColor.r = max(0.0, colorR.r);
		oColor.g = max(0.0, colorG.g);
		oColor.b = max(0.0, colorB.b);
		oColor.a = (colorR.a + colorG.a + colorB.a) / 3.0;
    $end
	$branch pp_type == 13
    $begin
		vec4 color = texture0Func(ps_texcoord);
		color.rgb = max(vec3(0.0), color.rgb);
		float luminance = 0.3 * color.r + 0.59 * color.g + 0.11 * color.b;
		vec4 grayscaleColor = vec4(vec3(luminance), color.a);
		oColor = mix(color, grayscaleColor, BWStrength);
		oColor.rgb = max(vec3(0.0), oColor.rgb);
    $end
	$branch pp_type == 14
    $begin
		vec4 color = texture0Func(ps_texcoord);
		color.rgb = max(vec3(0.0), color.rgb);
		vec2 uv = vec2(ps_texcoord.x / screenwidth, ps_texcoord.y / screenheight);
		vec2 centeredUV = uv - vec2(0.5, 0.5);
		float distance = length(centeredUV);
		float vignette = smoothstep(vignetteRadius, vignetteRadius - vignetteStrength, distance);
		oColor = color * vignette;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
    $end
	$branch pp_type == 15 || pp_type == 16
    $begin
		vec2 flip_texcoord;
		flip_texcoord.x = ps_texcoord.x;
		flip_texcoord.y = 1.0 - ps_texcoord.y;
		oColor = texture(normal2dTexture, flip_texcoord)*u_color;
		oColor.rgb = max(vec3(0.0), oColor.rgb);
	
		$branch pp_type == 16
		$begin
			if(oColor.a < 0.5)
				discard;
		$end
    $end
	$branch pp_type == 17
	$begin
		vec4 color = texture0Func(ps_texcoord);
		color.rgb = max(vec3(0.0), color.rgb) * u_exposure;
		oColor = vec4(aces(color.rgb), color.a);
	$end
	$branch pp_type == 18
	$begin
		vec4 color = texture0Func(ps_texcoord);
		color.rgb = max(vec3(0.0), color.rgb);
		float lum = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
		float logLum = (log2(clamp(lum, 0.0001, 16.0)) + 14.0) / 20.0;
		oColor = vec4(vec3(logLum), color.a);
	$end
}
$end