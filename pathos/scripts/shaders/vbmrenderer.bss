$global_determinator shadertype 0 9
$global_determinator flex 0 1
$global_determinator vertexlight 0 1
$shader_vertex
$begin
#version 130

uniform mat4 projection;
uniform mat4 modelview;
uniform mat4 normalmatrix;

uniform mat4 dlight_0_matrix;
uniform mat4 dlight_1_matrix;
uniform mat4 dlight_2_matrix;
uniform mat4 dlight_3_matrix;

uniform vec4 bones[96];

uniform mat4 modelmatrix;
uniform mat4 inv_modelmatrix;

uniform vec3 v_origin;
uniform vec3 v_right;

uniform vec2 scroll;

uniform vec4 causticsm1;
uniform vec4 causticsm2;

$branch flex == 1
$begin
uniform sampler2D flextexture;
uniform float flextexture_size;
$end

uniform highp int d_bumpmapping;
uniform highp int d_cubemaps;
uniform highp int d_numdlights;

uniform int d_chrome;

in vec3 in_position;
in vec3 in_tangent;
in vec3 in_normal;
in vec2 in_texcoord1;
in vec2 in_texcoord2;
in vec4 in_boneindexes;
in vec4 in_boneweights;
in vec2 in_flexcoord;

uniform vec4 u_lightstyle_values;

$branch vertexlight == 1
$begin
in vec3 in_vlight_vectors;
in vec3 in_vlight_diffuse;
in vec3 in_vlight_ambient;
$end

out vec3 ps_vertexpos;
out vec3 ps_tangent;
out vec3 ps_binormal;
out vec3 ps_normal;
out vec2 ps_texcoord1;
out vec2 ps_texcoord2;
out vec4 ps_dlight_0_vertexcoord;
out vec4 ps_dlight_1_vertexcoord;
out vec4 ps_dlight_2_vertexcoord;
out vec4 ps_dlight_3_vertexcoord;

$branch vertexlight == 1
$begin
out vec3 ps_vlight_vectors;
out vec3 ps_vlight_diffuse;
out vec3 ps_vlight_ambient;
$end

out vec3 ps_cubenormal;
out vec3 ps_cubetangent;
out vec3 ps_cubebinormal;
out vec3 ps_cubevertexpos;
out vec2 ps_causticcoord;

vec3 TransformVectorByBone( vec3 vin, int boneindex, float weight )
{
	vec3 tmp;
	tmp[0] = dot(vin, bones[boneindex].xyz)+bones[boneindex].w;
	tmp[1] = dot(vin, bones[boneindex+1].xyz)+bones[boneindex+1].w;
	tmp[2] = dot(vin, bones[boneindex+2].xyz)+bones[boneindex+2].w;
	
	return tmp*weight;
}

vec3 RotateVectorByBone( vec3 vin, int boneindex, float weight )
{
	vec3 tmp;
	tmp[0] = dot(vin, bones[boneindex].xyz);
	tmp[1] = dot(vin, bones[boneindex+1].xyz);
	tmp[2] = dot(vin, bones[boneindex+2].xyz);
	
	return tmp*weight;
}

void main()
{
	int boneindex1 = int(in_boneindexes.x);
	int boneindex2 = int(in_boneindexes.y);
	int boneindex3 = int(in_boneindexes.z);
	int boneindex4 = int(in_boneindexes.w);
	
	vec3 vert_origin = in_position;
	vec3 vert_normal = in_normal;
	
	$branch flex == 1
	$begin
		vert_origin = vert_origin + textureLod(flextexture, in_flexcoord, 0.0).xyz;
		
		vec2 texcoord_normal = vec2(in_flexcoord.x + 1.0/flextexture_size, in_flexcoord.y);
		vert_normal = normalize(vert_normal + textureLod(flextexture, texcoord_normal, 0.0).xyz);
	$end
	
	vec3 trans_origin;
	trans_origin = TransformVectorByBone( vert_origin, boneindex1, in_boneweights.x );
	trans_origin += TransformVectorByBone( vert_origin, boneindex2, in_boneweights.y );
	trans_origin += TransformVectorByBone( vert_origin, boneindex3, in_boneweights.z );
	trans_origin += TransformVectorByBone( vert_origin, boneindex4, in_boneweights.w );
	
	vec3 trans_normal;
	trans_normal = RotateVectorByBone( vert_normal, boneindex1, in_boneweights.x );
	trans_normal += RotateVectorByBone( vert_normal, boneindex2, in_boneweights.y );
	trans_normal += RotateVectorByBone( vert_normal, boneindex3, in_boneweights.z );
	trans_normal += RotateVectorByBone( vert_normal, boneindex4, in_boneweights.w );		
	
	vec3 trans_tangent;
	vec3 trans_binormal;
	if (d_bumpmapping == 1)
	{
		trans_tangent = RotateVectorByBone( in_tangent, boneindex1, in_boneweights.x );
		trans_tangent += RotateVectorByBone( in_tangent, boneindex2, in_boneweights.y );
		trans_tangent += RotateVectorByBone( in_tangent, boneindex3, in_boneweights.z );
		trans_tangent += RotateVectorByBone( in_tangent, boneindex4, in_boneweights.w );	
		ps_tangent = (normalmatrix*vec4(trans_tangent, 0.0)).xyz;
		
		trans_binormal = cross(trans_normal, trans_tangent);
		ps_binormal = (normalmatrix*vec4(trans_binormal, 0.0)).xyz;
	}
	
	vec4 position = vec4(trans_origin, 1.0)*modelview;

	ps_vertexpos = position.xyz;
	ps_normal = (normalmatrix*vec4(trans_normal, 0.0)).xyz;
	
	$branch vertexlight == 1
	$begin
		ps_vlight_ambient = in_vlight_ambient / 255.0;
		ps_vlight_diffuse = in_vlight_diffuse / 255.0;

		vec3 worldlightdir = -normalize((in_vlight_vectors / 127.5) - 1.0);
		ps_vlight_vectors = normalize((normalmatrix * vec4(worldlightdir, 0.0)).xyz);
	$end	
	
	$branch shadertype == 0 || shadertype == 1 || shadertype == 2 || shadertype == 3 || shadertype == 4 || shadertype == 5 || shadertype == 6 || shadertype == 7 || shadertype == 8 || shadertype == 9
	$begin
		ps_texcoord1 = in_texcoord1 + scroll;
	$end
	
	$branch shadertype == 8 || shadertype == 9
	$begin
		ps_texcoord2 = in_texcoord2;
	$end
	
	if(d_chrome == 1)
	{
		vec3 chromeup, chromeright, tmp;
		tmp = v_origin * -1;
		tmp += trans_origin;

		tmp = normalize(tmp);
		chromeup = cross(tmp, v_right);
		chromeup = normalize(chromeup);

		chromeright = cross(tmp, chromeup);
		chromeright = normalize(chromeright);

		// This is adding 0.5 only and not dividing by 2 because eye glint looks better this way
		float n = dot(trans_normal, chromeright);
		ps_texcoord1.x = (n*0.5) + 0.5;

		n = dot(trans_normal, chromeup);
		ps_texcoord1.y = (n*0.5) + 0.5;
	}

	if (d_cubemaps >= 1)
	{
		if (d_bumpmapping == 1)
		{
			ps_cubetangent = (inv_modelmatrix*vec4(trans_tangent, 0.0)).xyz;
			ps_cubebinormal = (inv_modelmatrix*vec4(trans_binormal, 0.0)).xyz;
		}
		
		ps_cubenormal = (inv_modelmatrix*vec4(trans_normal, 0.0)).xyz;
		ps_cubevertexpos = (vec4(trans_origin, 1.0) * modelmatrix).xyz;
	}
	
	if (d_numdlights >= 1)
		ps_dlight_0_vertexcoord = dlight_0_matrix * vec4(trans_origin, 1.0);
	if (d_numdlights >= 2)
		ps_dlight_1_vertexcoord = dlight_1_matrix * vec4(trans_origin, 1.0);
	if (d_numdlights >= 3)
		ps_dlight_2_vertexcoord = dlight_2_matrix * vec4(trans_origin, 1.0);
	if (d_numdlights >= 4)
		ps_dlight_3_vertexcoord = dlight_3_matrix * vec4(trans_origin, 1.0);

	ps_causticcoord.x = dot(vec4(trans_origin, 1.0), causticsm1);
	ps_causticcoord.y = dot(vec4(trans_origin, 1.0), causticsm2);

	gl_Position = position*projection;
}
$end
$shader_fragment 
$determinator alphatest 0 2
$invalid_state 2 alphatest 1 2 shadertype 2 4
$invalid_state 2 alphatest 1 2 shadertype 6 6
$invalid_state 2 vertexlight 1 1 shadertype 2 4
$invalid_state 2 vertexlight 1 1 shadertype 6 6
$invalid_state 2 vertexlight 1 1 shadertype 8 9
$begin
#version 130
#extension GL_ARB_texture_rectangle : enable

uniform sampler2D texture0;
uniform sampler2D texture1;
uniform sampler2DRect rectangle;

uniform vec3 skylight_ambient;
uniform vec3 skylight_diffuse;
uniform vec3 skylight_dir;

uniform float light_radius;

uniform vec3 fogcolor;
uniform vec2 fogparams;

uniform sampler2D mraotexture;
uniform sampler2D normalmap;

uniform sampler2D causticstex1;
uniform sampler2D causticstex2;
uniform vec4 causticscolor;

uniform samplerCube cubemap;
uniform samplerCube cubemap_prev;

uniform vec4 color;

uniform float interpolant;
uniform float caust_interp;
uniform float cubemapstrength;

// Parallax correction
uniform vec3 u_cube_min;
uniform vec3 u_cube_max;
uniform vec3 u_cube_origin;
uniform vec3 u_cube_prev_min;
uniform vec3 u_cube_prev_max;
uniform vec3 u_cube_prev_origin;
uniform mat4 inv_modelmatrix;

uniform float scope_scale;
uniform vec2 scope_scrsize;

uniform vec3 lights_0_origin;
uniform vec3 lights_0_color;
uniform float lights_0_radius;

uniform vec3 lights_1_origin;
uniform vec3 lights_1_color;
uniform float lights_1_radius;

uniform vec3 lights_2_origin;
uniform vec3 lights_2_color;
uniform float lights_2_radius;

uniform vec3 lights_3_origin;
uniform vec3 lights_3_color;
uniform float lights_3_radius;

uniform vec3 lights_4_origin;
uniform vec3 lights_4_color;
uniform float lights_4_radius;

uniform vec3 lights_5_origin;
uniform vec3 lights_5_color;
uniform float lights_5_radius;

uniform highp int d_bumpmapping;
uniform highp int d_cubemaps;
uniform highp int d_numdlights;
uniform highp int d_dlight0_shadow;
uniform highp int d_dlight1_shadow;
uniform highp int d_dlight2_shadow;
uniform highp int d_dlight3_shadow;

uniform int d_num_lights;
uniform int d_mrao;

uniform vec3 dlight_0_origin;
uniform float dlight_0_radius;
uniform vec4 dlight_0_color;
uniform sampler2D dlight_0_projtexture;
uniform float dlight_0_cone_size;
uniform vec3 dlight_0_spotdirection;
uniform samplerCube dlight_0_cubemap;
uniform sampler2D dlight_0_shadowmap;

uniform vec3 dlight_1_origin;
uniform float dlight_1_radius;
uniform vec4 dlight_1_color;
uniform sampler2D dlight_1_projtexture;
uniform float dlight_1_cone_size;
uniform vec3 dlight_1_spotdirection;
uniform samplerCube dlight_1_cubemap;
uniform sampler2D dlight_1_shadowmap;

uniform vec3 dlight_2_origin;
uniform float dlight_2_radius;
uniform vec4 dlight_2_color;
uniform sampler2D dlight_2_projtexture;
uniform float dlight_2_cone_size;
uniform vec3 dlight_2_spotdirection;
uniform samplerCube dlight_2_cubemap;
uniform sampler2D dlight_2_shadowmap;

uniform vec3 dlight_3_origin;
uniform float dlight_3_radius;
uniform vec4 dlight_3_color;
uniform sampler2D dlight_3_projtexture;
uniform float dlight_3_cone_size;
uniform vec3 dlight_3_spotdirection;
uniform samplerCube dlight_3_cubemap;
uniform sampler2D dlight_3_shadowmap;

in vec3 ps_vertexpos;
in vec3 ps_tangent;
in vec3 ps_binormal;
in vec3 ps_normal;
in vec2 ps_texcoord1;
in vec2 ps_texcoord2;

uniform vec4 u_lightstyle_values;

$branch vertexlight == 1
$begin
in vec3 ps_vlight_vectors;
in vec3 ps_vlight_diffuse;
in vec3 ps_vlight_ambient;
$end

in vec3 ps_cubenormal;
in vec3 ps_cubetangent;
in vec3 ps_cubebinormal;
in vec3 ps_cubevertexpos;
in vec2 ps_causticcoord;

in vec4 ps_dlight_0_vertexcoord;
in vec4 ps_dlight_1_vertexcoord;
in vec4 ps_dlight_2_vertexcoord;
in vec4 ps_dlight_3_vertexcoord;

out vec4 oColor;

#define M_PI 3.14159265358979323846264338327950288

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
	float a = roughness*roughness;
	float a2 = a*a;
	float NdotH = max(dot(N, H), 0.0);
	float NdotH2 = NdotH*NdotH;

	float nom = a2;
	float denom = (NdotH2*(a2-1.0)+1.0);
	denom = M_PI*denom*denom;

	return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
	float r = roughness+1.0;
	float k = (r*r)/8.0;

	float nom = NdotV;
	float denom = NdotV*(1.0-k)+k;

	return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float ggx1 = GeometrySchlickGGX(NdotV, roughness);
	float ggx2 = GeometrySchlickGGX(NdotL, roughness);

	return ggx1*ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
	return F0+(1.0-F0)*pow(clamp(1.0-cosTheta, 0.0, 1.0), 5.0);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
	return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 CookTorranceSpecular( vec3 v_origin, vec3 v_normal, vec3 lightDir, float roughness, vec3 F0 )
{
	// Eye vector (surface to camera)
	vec3 eyeVec = normalize( -v_origin );
	
	// Light vector (surface to light source)
	vec3 lightVec = normalize( -lightDir );
	
	// Halfway vector
	vec3 halfVec = normalize( lightVec + eyeVec );
	
	float NDF = DistributionGGX(v_normal, halfVec, roughness);
	float G = GeometrySmith(v_normal, eyeVec, lightVec, roughness);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	
	float NdotV = max(dot(v_normal, eyeVec), 0.0);
	float NdotL = max(dot(v_normal, lightVec), 0.0);
	
	float denom = 4.0 * NdotV * NdotL + 0.0001;
	
	return (NDF * G * F) / denom;
}

float LinearStep(float in1, float in2, float pmax)  
{  
	float value = (pmax-in1)/(in2-in1);
	return clamp(value, 0.0, 1.0);
}

float ReduceLightBleeding(float p_max, float Amount)  
{    
	return LinearStep(Amount, 1, p_max);  
}

float DepthTestCube( float depthcoord, samplerCube shadowmap, vec3 coord )
{
	vec4 momments = texture(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32;

	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0);

	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

float DepthTestProj( float depthcoord, sampler2D shadowmap, vec4 coord )
{
	vec4 momments = textureProj(shadowmap, coord);
	momments.xy = momments.xy+momments.zw/32;

	float diff = depthcoord-momments.x;
	float sgn = max(sign(diff), 0);

	float variance = momments.y-(momments.x*momments.x);
	variance = max(variance, 0.00005);
	
	float d = depthcoord-momments.x;
	float p_max = variance/(variance+d*d);
	return p_max*sgn+(1.0-sgn);
}

vec4 AddPointLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec4 v_coord, vec3 v_normal, vec3 mrao, vec3 albedo, out vec3 specOut )
{
	// Inverse squared radius
	float rad = l_radius * l_radius;
	vec3 dir = l_origin - v_origin;
	
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	
	dir = normalize(dir);
	attn = clamp(attn, 0.0, 1.0);
	
	float dp = dot(dir, v_normal);

	attn = max(dp, 0.0)*attn;
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * attn * l_color;
	
	specOut = vec3(0.0);
	if(d_mrao == 1)
	{
		// Add specular if any
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * l_color;
	}
	
	outColor.w = 0.0;
	
	return outColor;
}

float GetPointLightShadowing( float l_radius, vec4 v_coord, samplerCube l_shadowmap )
{
	float fldistance = clamp((length(v_coord.xyz)/l_radius), 0.0, 1.0);
	float flresult = DepthTestCube(fldistance, l_shadowmap, normalize(v_coord.xyz));
	return ReduceLightBleeding(flresult, 0.4);
}

vec4 AddProjLight( float l_radius, vec3 l_origin, vec3 l_color, vec3 v_origin, vec4 v_coord, vec3 v_normal, sampler2D l_texture, vec3 mrao, vec3 albedo, float l_cone_size, vec3 l_spotdirection, out vec3 specOut )
{
	float rad = l_radius*l_radius;
	vec3 dir = l_origin-v_origin;
	float dist = dot(dir, dir);
	float attn = (dist/rad-1.0)*-1.0;
	attn = clamp(attn, 0.0, 1.0);
	
	dir = normalize(dir);
	
	float dp = max(dot(dir, v_normal), 0.0);
	
	vec4 texclamp = max(v_coord, 0.0);
	vec4 texColor = textureProj(l_texture, texclamp);
	
	float spotcos = cos((l_cone_size*2.0)*0.3*(M_PI*2.0/360.0));
	
	vec3 spotdirection = normalize(l_spotdirection);
	float spotatten = -dot(spotdirection, dir);
	
	spotatten = max(spotatten, spotcos);
	float spotfactor = (spotatten - spotcos)/(1.0 - spotcos);
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * texColor.xyz * attn * l_color * dp * spotfactor;
	
	specOut = vec3(0.0);
	if (d_mrao == 1)
	{
		// Add specular if any
		float lightStrength = ((texColor.x + texColor.y + texColor.z) / 3.0)*2.0;
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * dp * lightStrength * spotfactor * l_color;
	}
	
	outColor.w = 0.0;
	
	return outColor;
}

float GetProjLightShadowing( float l_radius, vec3 l_origin, vec3 v_origin, vec4 v_coord, sampler2D l_shadowmap )
{
	vec4 texclamp = max(v_coord, 0.0);
	float fldistance = clamp((length(l_origin-v_origin)/l_radius), 0.0, 1.0);
	float flresult = DepthTestProj(fldistance, l_shadowmap, texclamp);
	return ReduceLightBleeding(flresult, 0.4);
}

vec4 AddModelLight( vec3 l_origin, vec3 l_color, float l_radius, vec3 v_origin, vec3 v_normal, vec3 mrao, vec3 albedo, out vec3 specOut )
{
	// Inverse squared radius
	float rad = l_radius * l_radius;
	vec3 dir = l_origin - v_origin;

	float dist = dot(dir, dir);
	float attn = ((dist/rad)-1.0)*-1.0;
	
	attn = clamp(attn, 0.0, 1.0);
	dir = normalize(dir);
	float dp = dot(dir, v_normal);
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(dir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * l_color * attn * max(dp, 0.0);
	
	specOut = vec3(0.0);
	if(d_mrao == 1)
	{
		// Add specular if any
		specOut = CookTorranceSpecular(v_origin, v_normal, -dir, mrao.y, F0) * attn * max(dp, 0.0) * l_color;
	}
	
	outColor.w = 0.0;
	
	return outColor;
}

vec4 AddBaseLight( vec3 s_lightdir, vec3 s_ambient, vec3 s_diffuse, vec3 v_normal, vec3 v_origin, vec3 mrao, vec3 albedo, float styleStrength, out vec3 specOut )
{
	float fldot = -dot(s_lightdir, v_normal);
	fldot = clamp(fldot, 0.0, 1.0);
	
	vec3 eyeVec = normalize(-v_origin);
	vec3 halfVec = normalize(-s_lightdir + eyeVec);
	vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
	vec3 F = FresnelSchlick(clamp(dot(halfVec, eyeVec), 0.0, 1.0), F0);
	vec3 kD = ((vec3(1.0) - F) * (1.0 - mrao.x)) / M_PI;

	vec4 outColor;
	outColor.xyz = kD * (s_ambient + (fldot * s_diffuse));
	
	specOut = vec3(0.0);
	if (d_mrao == 1)
	{
		specOut = CookTorranceSpecular(v_origin, v_normal, s_lightdir, mrao.y, F0) * s_diffuse;
	}
	
	outColor.w = 0.0;
	
	return outColor * styleStrength;
}

vec3 AddDiffuseLight ( vec3 colorIn1, vec3 colorIn2 )
{
	vec3 outValue = colorIn1;
	outValue += colorIn2;
	return outValue;
}

vec3 AddDiffuseDynamicLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

vec3 AddSpecularLight ( vec3 colorIn1, vec3 colorIn2 )
{
	return colorIn1 + colorIn2;
}

vec4 EncodeDepth( vec3 v_origin, float l_radius )
{
	float depth = length(v_origin);
	depth = clamp((depth/l_radius), 0.0, 1.0);

	vec2 momments = vec2(depth, depth*depth);
	float dx = dFdx(depth);
	float dy = dFdy(depth);
	momments.y += 0.25*(dx*dx+dy*dy);

	vec2 fracval = fract(momments*32);

	vec4 finalColor;
	finalColor.x = momments.x-(fracval.x/32);
	finalColor.y = momments.y-(fracval.y/32);
	finalColor.zw = fracval;
	
	return finalColor;
}

vec4 GetCubemapPixel ( vec3 reflectvec, vec3 reflectvecprev, float roughness )
{
	float maxMipLevel = floor(log2(float(textureSize(cubemap, 0).x)));
	float mipLevel = clamp(roughness, 0.0, 1.0) * maxMipLevel;
	
	vec4 outColor;
	if( d_cubemaps != 2 )
	{
		outColor = textureLod(cubemap, reflectvec, mipLevel);
	}
	else
	{
		vec4 color1 = textureLod(cubemap_prev, reflectvecprev, mipLevel);
		vec4 color2 = textureLod(cubemap, reflectvec, mipLevel);
		
		outColor = (1.0 - interpolant) * color1 + color2 * interpolant;
	}
	
	return outColor;
}

vec3 CubemapParallaxCorrect(vec3 R, vec3 fragPos, vec3 boxMin, vec3 boxMax, vec3 probePos)
{
	vec3 invR = 1.0 / R;
	vec3 t1 = (boxMin - fragPos) * invR;
	vec3 t2 = (boxMax - fragPos) * invR;
	vec3 tmin = min(t1, t2);
	vec3 tmax = max(t1, t2);
	float t_near = max(max(tmin.x, tmin.y), tmin.z);
	float t_far = min(min(tmax.x, tmax.y), tmax.z);

	t_near = min(t_far, t_near);
	t_far = max(0, t_far);
	
	float intersection_t = t_far;
	vec3 intersectPos = fragPos + R * intersection_t;
	return -normalize(intersectPos - probePos);
}

vec4 AddCubemaps( vec3 mrao, vec3 albedo )
{ 
	if( d_cubemaps == 0 )
	{
		return vec4(0, 0, 0, 0);
	}
	else
	{
		vec3 v_normal;
		if( d_bumpmapping == 1 )
		{
			mat3 tbnMatrix = mat3(ps_cubetangent, ps_cubebinormal, ps_cubenormal);
			vec3 tex_normal = (2.0 * texture2D (normalmap, ps_texcoord1).xyz) - 1.0;
			vec3 eye_texnormal = normalize(tbnMatrix * tex_normal);
			
			v_normal = eye_texnormal;
		}
		else
		{
			v_normal = ps_cubenormal;
		}

		vec3 view_dir = normalize(ps_cubevertexpos);

		vec3 reflectvec = reflect(view_dir, v_normal);

		vec3 local_cube_min = (inv_modelmatrix * vec4(u_cube_min, 1.0)).xyz;
		vec3 local_cube_max = (inv_modelmatrix * vec4(u_cube_max, 1.0)).xyz;
		vec3 local_cube_origin = (inv_modelmatrix * vec4(u_cube_origin, 1.0)).xyz;
		vec3 reflectvec_current = CubemapParallaxCorrect(reflectvec, ps_cubevertexpos, local_cube_min, local_cube_max, local_cube_origin);

		vec3 reflectvec_prev;
		if( d_cubemaps == 2 )
		{
			local_cube_min = (inv_modelmatrix * vec4(u_cube_prev_min, 1.0)).xyz;
			local_cube_max = (inv_modelmatrix * vec4(u_cube_prev_max, 1.0)).xyz;
			local_cube_origin = (inv_modelmatrix * vec4(u_cube_prev_origin, 1.0)).xyz;
			reflectvec_prev = CubemapParallaxCorrect(reflectvec, ps_cubevertexpos, local_cube_min, local_cube_max, local_cube_origin);
		}

		vec3 F0 = mix(vec3(0.04), albedo, mrao.x);
		float NdotV = max(dot(v_normal, -view_dir), 0.0);
		vec3 F = FresnelSchlickRoughness(NdotV, F0, mrao.y);
		return GetCubemapPixel(reflectvec_current, reflectvec_prev, mrao.y) * vec4(F * mrao.z, 1.0);
	}
}

float SplineFraction( float value, float scale )
{
	float valueSquared;

	value = scale * value;
	valueSquared = value * value;

	// Nice little ease-in, ease-out spline-like curve
	return 3 * valueSquared - 2 * valueSquared * value;
}

float CalcFogFactor( vec3 v_origin, vec2 f_params )
{
	float fp_fogcoord = length(v_origin);
	float fp_fogfactor = (f_params.x - fp_fogcoord)*f_params.y;
	
	return 1.0-SplineFraction(clamp(fp_fogfactor, 0.0, 1.0), 1.0);
}

vec3 GetCausticsColor( vec3 surfaceLight )
{
	if (causticscolor.w <= 0.0)
	{
		return vec3(0.0);
	}

	vec4 c1 = texture(causticstex1, ps_causticcoord);
	vec4 c2 = texture(causticstex2, ps_causticcoord);
	vec4 c = mix(c1, c2, caust_interp);

	return c.rgb * causticscolor.rgb * surfaceLight;
}

vec3 GetNormal( vec2 texcoord, sampler2D normalmap, vec3 v_normal, mat3 tbnMatrix )
{
	if(d_bumpmapping == 0)
	{
		return v_normal;
	}
	else
	{
		vec3 out_normal = (2.0 * texture2D (normalmap, texcoord).xyz) - 1.0;
		return normalize(tbnMatrix * out_normal);
	}
}

void main()
{
	mat3 tbnMatrix;
	vec3 mrao = vec3(0.0, 1.0, 1.0);
	vec4 mraoSample = vec4(0.0, 1.0, 1.0, 1.0);
	vec3 specularColor = vec3(0.0, 0.0, 0.0);
	vec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0);
	
	// Get the MRAO texture if needed
	if (d_mrao == 1 || d_cubemaps >= 1)
	{
		mraoSample = texture(mraotexture, ps_texcoord1);
		mrao = mraoSample.zyx;
	}
	
	if (d_mrao == 1)
	{
		finalColor.xyz += vec3(1.0 - mraoSample.a);
	}
	
	// Build the TBN matrix if required
	if (d_bumpmapping == 1)
		tbnMatrix = mat3(ps_tangent, ps_binormal, ps_normal);
	else
		tbnMatrix = mat3(vec3(0, 0, 0), vec3(0, 0, 0), vec3(0, 0, 0));
	
	// Normal depends on rendering type
	vec3 v_normal = GetNormal(ps_texcoord1, normalmap, ps_normal, tbnMatrix);
	
	// Base lighting
	vec4 lightColor;
	vec3 baseSpec;
	$branch shadertype == 0 || shadertype == 1
	$begin
		$branch vertexlight == 0
		$begin
			lightColor = AddBaseLight(skylight_dir, skylight_ambient, skylight_diffuse, v_normal, ps_vertexpos, mrao, texture(texture0, ps_texcoord1).rgb, 1.0, baseSpec);
			
			// Add in the diffuse light
			finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
			
			// Add to specular
			specularColor = AddSpecularLight(specularColor, baseSpec);
		$end
		$branch vertexlight == 1
		$begin
			lightColor = AddBaseLight(ps_vlight_vectors, ps_vlight_ambient, ps_vlight_diffuse, v_normal, ps_vertexpos, mrao, texture(texture0, ps_texcoord1).rgb, 1.0, baseSpec);
			
			// Add in the diffuse light
			finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
			
			// Add to specular
			specularColor = AddSpecularLight(specularColor, baseSpec);
		$end
	$end
	
	// Elights
	vec3 mlight_origin;
	vec3 mlight_color;
	float mlight_radius;
	vec3 mlightSpec;
	if (d_num_lights >= 1)
	{
		mlight_origin = lights_0_origin;
		mlight_color = lights_0_color;
		mlight_radius = lights_0_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	if (d_num_lights >= 2)
	{
		mlight_origin = lights_1_origin;
		mlight_color = lights_1_color;
		mlight_radius = lights_1_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	if (d_num_lights >= 3)
	{
		mlight_origin = lights_2_origin;
		mlight_color = lights_2_color;
		mlight_radius = lights_2_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	if (d_num_lights >= 4)
	{
		mlight_origin = lights_3_origin;
		mlight_color = lights_3_color;
		mlight_radius = lights_3_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	if (d_num_lights >= 5)
	{
		mlight_origin = lights_4_origin;
		mlight_color = lights_4_color;
		mlight_radius = lights_4_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	if (d_num_lights == 6)
	{
		mlight_origin = lights_5_origin;
		mlight_color = lights_5_color;
		mlight_radius = lights_5_radius;
		
		lightColor = AddModelLight(mlight_origin, mlight_color, mlight_radius, ps_vertexpos, v_normal, mrao, texture(texture0, ps_texcoord1).rgb, mlightSpec);
		
		// Add in the diffuse light
		finalColor.xyz = AddDiffuseLight(finalColor.xyz, lightColor.xyz);
		
		// Add to specular
		specularColor = AddSpecularLight(specularColor, mlightSpec);
	}
	
	// Normal single pass rendering
	$branch shadertype == 0 || shadertype == 1
	$begin
		vec4 textureColor = texture(texture0, ps_texcoord1);
		
		vec3 dlightDiffuse = vec3(0.0);
		if(d_numdlights >= 1)
		{
			vec3 specLight;
			vec4 lightColor = (dlight_0_cone_size > 0.0) ? AddProjLight(dlight_0_radius, dlight_0_origin, dlight_0_color.xyz, ps_vertexpos, ps_dlight_0_vertexcoord, v_normal, dlight_0_projtexture, mrao, textureColor.rgb, dlight_0_cone_size, dlight_0_spotdirection, specLight) : AddPointLight(dlight_0_radius, dlight_0_origin, dlight_0_color.xyz, ps_vertexpos, ps_dlight_0_vertexcoord, v_normal, mrao, textureColor.rgb, specLight);
			if( d_dlight0_shadow == 1 )
			{
				float shadowFactor = (dlight_0_cone_size > 0.0) ? GetProjLightShadowing(dlight_0_radius, dlight_0_origin, ps_vertexpos, ps_dlight_0_vertexcoord, dlight_0_shadowmap) : GetPointLightShadowing(dlight_0_radius, ps_dlight_0_vertexcoord, dlight_0_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numdlights >= 2)
		{
			vec3 specLight;
			vec4 lightColor = (dlight_1_cone_size > 0.0) ? AddProjLight(dlight_1_radius, dlight_1_origin, dlight_1_color.xyz, ps_vertexpos, ps_dlight_1_vertexcoord, v_normal, dlight_1_projtexture, mrao, textureColor.rgb, dlight_1_cone_size, dlight_1_spotdirection, specLight) : AddPointLight(dlight_1_radius, dlight_1_origin, dlight_1_color.xyz, ps_vertexpos, ps_dlight_1_vertexcoord, v_normal, mrao, textureColor.rgb, specLight);
			if( d_dlight1_shadow == 1 )
			{
				float shadowFactor = (dlight_1_cone_size > 0.0) ? GetProjLightShadowing(dlight_1_radius, dlight_1_origin, ps_vertexpos, ps_dlight_1_vertexcoord, dlight_1_shadowmap) : GetPointLightShadowing(dlight_1_radius, ps_dlight_1_vertexcoord, dlight_1_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numdlights >= 3)
		{
			vec3 specLight;
			vec4 lightColor = (dlight_2_cone_size > 0.0) ? AddProjLight(dlight_2_radius, dlight_2_origin, dlight_2_color.xyz, ps_vertexpos, ps_dlight_2_vertexcoord, v_normal, dlight_2_projtexture, mrao, textureColor.rgb, dlight_2_cone_size, dlight_2_spotdirection, specLight) : AddPointLight(dlight_2_radius, dlight_2_origin, dlight_2_color.xyz, ps_vertexpos, ps_dlight_2_vertexcoord, v_normal, mrao, textureColor.rgb, specLight);
			if( d_dlight2_shadow == 1 )
			{
				float shadowFactor = (dlight_2_cone_size > 0.0) ? GetProjLightShadowing(dlight_2_radius, dlight_2_origin, ps_vertexpos, ps_dlight_2_vertexcoord, dlight_2_shadowmap) : GetPointLightShadowing(dlight_2_radius, ps_dlight_2_vertexcoord, dlight_2_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		if(d_numdlights >= 4)
		{
			vec3 specLight;
			vec4 lightColor = (dlight_3_cone_size > 0.0) ? AddProjLight(dlight_3_radius, dlight_3_origin, dlight_3_color.xyz, ps_vertexpos, ps_dlight_3_vertexcoord, v_normal, dlight_3_projtexture, mrao, textureColor.rgb, dlight_3_cone_size, dlight_3_spotdirection, specLight) : AddPointLight(dlight_3_radius, dlight_3_origin, dlight_3_color.xyz, ps_vertexpos, ps_dlight_3_vertexcoord, v_normal, mrao, textureColor.rgb, specLight);
			if( d_dlight3_shadow == 1 )
			{
				float shadowFactor = (dlight_3_cone_size > 0.0) ? GetProjLightShadowing(dlight_3_radius, dlight_3_origin, ps_vertexpos, ps_dlight_3_vertexcoord, dlight_3_shadowmap) : GetPointLightShadowing(dlight_3_radius, ps_dlight_3_vertexcoord, dlight_3_cubemap);
				lightColor *= shadowFactor;
				specLight *= shadowFactor;
			}
			dlightDiffuse = AddDiffuseDynamicLight(dlightDiffuse, lightColor.xyz);
			specularColor = AddSpecularLight(specularColor, specLight);
		}
		
		finalColor.xyz = finalColor.xyz*textureColor.xyz + dlightDiffuse*textureColor.rgb + specularColor;
		finalColor.w = finalColor.w*textureColor.w;
		finalColor.xyz *= 2;
		finalColor = finalColor*color;
		
		finalColor.rgb += GetCausticsColor(finalColor.rgb);
		
		if( d_cubemaps >= 1 )
			finalColor.xyz += AddCubemaps(mrao, textureColor.rgb).xyz;
	$end

	// Solid color
	$branch shadertype == 2
	$begin
		finalColor = color;
	$end
	
	// VSM shadow encoding
	$branch shadertype == 3 || shadertype == 4
	$begin
		finalColor = EncodeDepth( ps_vertexpos, light_radius );
		
		$branch shadertype == 4
		$begin
			if(texture(texture0, ps_texcoord1).w < 0.5)
				discard;
		$end
	$end

	// Texture with no lighting
	$branch shadertype == 5
	$begin
		finalColor = texture(texture0, ps_texcoord1);	
	$end

	// Scope
	$branch shadertype == 6
	$begin
		float fldot = -dot(skylight_dir, ps_normal);
		finalColor.xyz += skylight_ambient+fldot*skylight_diffuse;

		vec2 texcoord;
		texcoord = ps_texcoord1 - 0.5;
		texcoord *= scope_scale;

		texcoord = texcoord + 0.5;
		texcoord.x = 1.0-texcoord.x;
		texcoord.y = 1.0-texcoord.y;
		
		texcoord.x *= scope_scrsize.x;
		texcoord.y *= scope_scrsize.y;

		vec4 texcolor = texture(texture0, ps_texcoord1);
		vec4 rectcolor = texture(rectangle, texcoord);
		
		finalColor = mix(rectcolor, texcolor*finalColor, texcolor.w);
	$end

	// Texture only and with fog
	$branch shadertype == 7
	$begin
		finalColor = texture(texture0, ps_texcoord1)*color;
	$end
	
	// Texture with alpha holes for decals
	$branch shadertype == 8 || shadertype == 9
	$begin
		finalColor = texture(texture0, ps_texcoord1);
		vec4 alphacolor = texture(texture1, ps_texcoord2);
		finalColor.a = finalColor.a*alphacolor.a;
	$end	
	
	// Fog calculations
	$branch shadertype == 1 || shadertype == 7 || shadertype == 9
	$begin
		float fogfactor = CalcFogFactor( ps_vertexpos.xyz, fogparams );
		finalColor.xyz = mix(finalColor.xyz, fogcolor, fogfactor);
	$end

	$branch alphatest == 1
	$begin
		if(finalColor.a < 0.5)
			discard;
	$end
	$branch alphatest == 2
	$begin
		finalColor.a = (finalColor.a - 0.5) / max(fwidth(finalColor.a), 0.0001) + 0.5;
	$end	

	oColor = finalColor;
}
$end