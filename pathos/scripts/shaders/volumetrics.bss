$shader_vertex $begin
#version 130

uniform mat4 projection;
uniform mat4 modelview;

in vec4 in_position;
in vec2 in_texcoord;

out vec2 ps_texcoord;

void main()
{
	ps_texcoord = in_texcoord;
	vec4 position = in_position * modelview;
	gl_Position = position * projection;
}
$end
$shader_fragment
$determinator pass 0 1
$begin
#version 130

#define MAX_VOL_LIGHTS 4
#define M_PI 3.14159265358979323846264338327950288

struct vol_light_t
{
	vec4 posRadius;
	vec4 colorIntensity;
	vec4 spotDirCone;
	mat4 lightMatrix;
	int hasShadow;
};

uniform vol_light_t u_lights[MAX_VOL_LIGHTS];
uniform int u_numLights;
uniform int u_samples;

uniform sampler2D u_depthMap;
uniform sampler2D u_volTexture;

uniform sampler2D u_spotProjTex[MAX_VOL_LIGHTS];
uniform sampler2D u_spotShadowMap[MAX_VOL_LIGHTS];
uniform samplerCube u_cubeShadowMap[MAX_VOL_LIGHTS];

uniform mat4 u_scene_projection_inverse;
uniform mat4 u_inv_view;
uniform vec3 u_viewPos;
uniform float u_maxRayDist;

in vec2 ps_texcoord;
out vec4 oColor;

const float dither[16] = float[](
	 0.0/16.0,  8.0/16.0,  2.0/16.0, 10.0/16.0,
	12.0/16.0,  4.0/16.0, 14.0/16.0,  6.0/16.0,
	 3.0/16.0, 11.0/16.0,  1.0/16.0,  9.0/16.0,
	15.0/16.0,  7.0/16.0, 13.0/16.0,  5.0/16.0
);

float LinearStep(float in1, float in2, float pmax)  
{  
	return clamp((pmax - in1) / (in2 - in1), 0.0, 1.0);
}

float DepthTestCube(float depthcoord, samplerCube shadowmap, vec3 coord)
{
	vec4 moments = texture(shadowmap, normalize(coord));
	moments.xy = moments.xy + moments.zw / 32.0;
	float diff = depthcoord - moments.x;
	float sgn = max(sign(diff), 0.0);
	float variance = max(moments.y - (moments.x * moments.x), 0.00005);
	float p_max = variance / (variance + diff * diff);
	float shadow = p_max * sgn + (1.0 - sgn);
	return LinearStep(0.4, 1.0, shadow);
}

float DepthTestProj(float depthcoord, sampler2D shadowmap, vec4 coord)
{
	vec4 moments = textureProj(shadowmap, coord);
	moments.xy = moments.xy + moments.zw / 32.0;
	float diff = depthcoord - moments.x;
	float sgn = max(sign(diff), 0.0);
	float variance = max(moments.y - (moments.x * moments.x), 0.00005);
	float p_max = variance / (variance + diff * diff);
	float shadow = p_max * sgn + (1.0 - sgn);
	return LinearStep(0.4, 1.0, shadow);
}

vec3 calcWorldPosition(vec2 coords, float rawDepth)
{
	vec4 ndc = vec4(coords * 2.0 - 1.0, rawDepth * 2.0 - 1.0, 1.0);
	vec4 vs_pos = ndc * u_scene_projection_inverse;
	vs_pos /= vs_pos.w;
	vec4 ws_pos = vs_pos * u_inv_view;
	return ws_pos.xyz;
}

void main()
{
	$branch pass == 0
	$begin
		float rawDepth = texture(u_depthMap, ps_texcoord).r;
		vec3 fragPos;

		if (rawDepth >= 0.9999)
		{
			vec4 ndc = vec4(ps_texcoord * 2.0 - 1.0, 1.0, 1.0);
			vec4 vs_pos = ndc * u_scene_projection_inverse;
			vs_pos /= vs_pos.w;
			vec3 viewDir = normalize((vs_pos * u_inv_view).xyz - u_viewPos);
			fragPos = u_viewPos + viewDir * u_maxRayDist;
		}
		else
		{
			fragPos = calcWorldPosition(ps_texcoord, rawDepth);
		}

		vec3 startPos = u_viewPos;
		vec3 rayVector = fragPos - startPos;
		float rayLength = length(rayVector);
		if (rayLength <= 0.001)
		{
			oColor = vec4(0.0);
			return;
		}

		vec3 rayDir = rayVector / rayLength;
		int ditherIndex = (int(gl_FragCoord.x) % 4) + (int(gl_FragCoord.y) % 4) * 4;
		float ditherVal = dither[ditherIndex];

		vec3 accumVol = vec3(0.0);

		for (int i = 0; i < u_numLights; ++i)
		{
			float vIntensity = u_lights[i].colorIntensity.w;
			if (vIntensity <= 0.0)
				continue;

			vec3 lPos = u_lights[i].posRadius.xyz;
			float lRad = u_lights[i].posRadius.w;
			float lRadSq = lRad * lRad;

			// Intersect ray with light sphere
			vec3 L = lPos - startPos;
			float tca = dot(L, rayDir);
			float d2 = dot(L, L) - tca * tca;

			if (d2 > lRadSq)
				continue;

			float thc = sqrt(lRadSq - d2);
			float t0 = max(tca - thc, 0.0);
			float t1 = min(tca + thc, rayLength);
			float marchLen = t1 - t0;

			if (marchLen <= 0.0)
				continue;

			int steps = max(u_samples, 4);
			float stepSize = marchLen / float(steps);
			vec3 currentPos = startPos + rayDir * (t0 + stepSize * ditherVal);

			vec3 lightVol = vec3(0.0);
			bool isSpot = (u_lights[i].spotDirCone.w > 0.0);

			for (int s = 0; s < steps; ++s)
			{
				float dist = length(lPos - currentPos);
				float attn = clamp(1.0 - (dist / lRad), 0.0, 1.0);
				attn *= attn;

				if (attn > 0.0)
				{
					float shadow = 1.0;
					float spotFactor = 1.0;

					if (isSpot)
					{
						vec3 dirToLight = normalize(currentPos - lPos);
						vec3 spotDir = normalize(u_lights[i].spotDirCone.xyz);
						float spotCos = cos((u_lights[i].spotDirCone.w * 2.0) * 0.3 * (M_PI * 2.0 / 360.0));
						float spotAtten = dot(spotDir, dirToLight);

						if (spotAtten > spotCos)
						{
							spotFactor = (spotAtten - spotCos) / (1.0 - spotCos);
							vec4 lightCoord = u_lights[i].lightMatrix * vec4(currentPos, 1.0);
							vec4 projColor = textureProj(u_spotProjTex[i], lightCoord);
							spotFactor *= (projColor.r + projColor.g + projColor.b) / 3.0;

							if (u_lights[i].hasShadow == 1)
							{
								shadow = DepthTestProj(clamp(dist / lRad, 0.0, 1.0), u_spotShadowMap[i], lightCoord);
							}
						}
						else
						{
							spotFactor = 0.0;
						}
					}
					else if (u_lights[i].hasShadow == 1)
					{
						vec4 cubeCoord = u_lights[i].lightMatrix * vec4(currentPos, 1.0);
						shadow = DepthTestCube(clamp(dist / lRad, 0.0, 1.0), u_cubeShadowMap[i], cubeCoord.xyz);
					}

					lightVol += u_lights[i].colorIntensity.rgb * attn * spotFactor * shadow * stepSize;
				}

				currentPos += rayDir * stepSize;
			}

			accumVol += lightVol * vIntensity;
		}

		oColor = vec4(accumVol, 1.0);
	$end

	$branch pass == 1
	$begin
		vec2 texelSize = 1.0 / vec2(textureSize(u_volTexture, 0));
		vec3 result = vec3(0.0);
		for (int y = -1; y <= 1; ++y)
		{
			for (int x = -1; x <= 1; ++x)
			{
				vec2 offset = vec2(float(x), float(y)) * texelSize;
				result += texture(u_volTexture, ps_texcoord + offset).rgb;
			}
		}
		result /= 9.0;
		oColor = vec4(result, 1.0);
	$end
}
$end