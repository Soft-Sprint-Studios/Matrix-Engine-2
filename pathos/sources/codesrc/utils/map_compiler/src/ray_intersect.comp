#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

struct RayInput
{
    vec4 origin_tmin;
    vec4 dir_tmax;
};

layout(std430, set = 0, binding = 1) readonly buffer InRayBuffer
{
    RayInput rays[];
};

layout(std430, set = 0, binding = 2) writeonly buffer OutHitBuffer
{
    vec4 results[];
};

struct PrimData
{
    vec2 uv0;
    vec2 uv1;
    vec2 uv2;
    int texIndex;
    int faceIndex;
};

layout(std430, set = 0, binding = 3) readonly buffer InPrimData
{
    PrimData prims[];
};

layout(set = 0, binding = 4) uniform sampler2D textures[256];

layout(push_constant) uniform PushConstants
{
    uint numRays;
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= numRays)
    {
        return;
    }

    vec3 origin = rays[idx].origin_tmin.xyz;
    float tmin = rays[idx].origin_tmin.w;
    vec3 dir = rays[idx].dir_tmax.xyz;
    float tmax = rays[idx].dir_tmax.w;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, tmin, dir, tmax);

    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
        {
            uint primID = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
            PrimData pd = prims[primID];
            if (pd.texIndex >= 0)
            {
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, false);
                float w = 1.0 - bary.x - bary.y;
                vec2 uv = w * pd.uv0 + bary.x * pd.uv1 + bary.y * pd.uv2;
                float alpha = texture(textures[nonuniformEXT(pd.texIndex)], uv).a;
                if (alpha >= 0.5)
                {
                    rayQueryConfirmIntersectionEXT(query);
                }
            }
            else
            {
                rayQueryConfirmIntersectionEXT(query);
            }
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
    {
        uint primID = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        PrimData pd = prims[primID];
        vec3 albedo = vec3(0.5);
        if (pd.texIndex >= 0)
        {
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
            float w = 1.0 - bary.x - bary.y;
            vec2 uv = w * pd.uv0 + bary.x * pd.uv1 + bary.y * pd.uv2;
            vec4 col = texture(textures[nonuniformEXT(pd.texIndex)], uv);
            albedo = pow(col.rgb, vec3(2.2));
        }
        results[idx] = vec4(albedo, uintBitsToFloat(uint(pd.faceIndex)));
    }
    else
    {
        results[idx] = vec4(0.0, 0.0, 0.0, uintBitsToFloat(0xFFFFFFFFu));
    }
}